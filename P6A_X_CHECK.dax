// =====================================================================================
// P6A_K3Y_CHECK.dax  -  BUILD 2026-11-12b  -  read-only, after P6A_MEASURES_TE2.csx build 12b (+ Ctrl+S)
// K3 split card, CPY side. DAX query view > paste > Run. Note the time in ms (K3 is one of the heavier visuals).
// Y1: card texts (now "at 80 %+ incl. over / over", so one breach reads 1 / 1). Y2: tooltip rows (any limit). Y3: movers.
// =====================================================================================
DEFINE
    VAR _kScope = TREATAS ( { "Hedge fund" }, DIM_COUNTERPARTY[HF Scope] )

// ---- Y1 card texts. Expect CPH "0 / 0 of 44 CPHs" on 4 Nov (MEASURES_CHECK C2); CPY side ≥ CPH side ----------------
EVALUATE
    UNION (
        CALCULATETABLE (
            ROW ( "Source", [P6 16A Source], "CPH", [P6 K3 Text], "CPHDetail", [P6 K3 Detail],
                "CPY", [P6 K3Y Text], "CPYDetail", [P6 K3Y Detail], "CPYColour", [P6 K3Y Colour] ),
            _kScope, TREATAS ( { "Facts" }, 'P1 Source'[Source] ) ),
        CALCULATETABLE (
            ROW ( "Source", [P6 16A Source], "CPH", [P6 K3 Text], "CPHDetail", [P6 K3 Detail],
                "CPY", [P6 K3Y Text], "CPYDetail", [P6 K3Y Detail], "CPYColour", [P6 K3Y Colour] ),
            _kScope, TREATAS ( { "CORTEX" }, 'P1 Source'[Source] ) ) )

// ---- Y2 tooltip rows: CPYs at 80 %+ of any limit (expect the CPY at 116 % of 16A on 9 Nov, plus any 06 / 17A / 17B) --
EVALUATE
    FILTER (
        SUMMARIZECOLUMNS ( DIM_COUNTERPARTY[CPY Label], DIM_COUNTERPARTY[CPH_Label], _kScope,
            "Breach", [P6 Lim Breach List], "Near", [P6 Lim Near List], "Worst", [P6 Lim Worst],
            "Amounts", [P6 Lim Worst Amounts], "vsCmp", [P6 Lim vs Cmp], "Structure16A", [P6 K3Y Structure],
            "Max", [P6 Lim Max %], "Flag", [P6 Lim Flag] ),
        [Flag] = 1 )
    ORDER BY [Max] DESC

// ---- Y3 movers column + CPH colour (CPHs with a breach or 80 %+ on any limit) ------------------------------------------
EVALUATE
    FILTER (
        SUMMARIZECOLUMNS ( DIM_COUNTERPARTY[CPH_Label], _kScope,
            "Breach", [P6 Lim Breach List], "Near", [P6 Lim Near List], "Colour", [P6 Lim Colour] ),
        NOT ISBLANK ( [Colour] ) )
