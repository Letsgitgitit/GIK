// =====================================================================================
// P6A_K3Y_CHECK.dax  -  BUILD 2026-11-12a  -  read-only, after P6A_MEASURES_TE2.csx build 12a (+ Ctrl+S)
// K3 split card, CPY side. DAX query view > paste > Run. Note the time in ms (K3 is one of the heavier visuals).
// Y1: card texts (CPH side and CPY side, facts and CORTEX). Y2: the tooltip rows (CPYs at 80 % or more).
// =====================================================================================
DEFINE
    VAR _kScope = TREATAS ( { "Hedge fund" }, DIM_COUNTERPARTY[HF Scope] )

// ---- Y1 card texts. Expect CPH "0 / 0 of 44 CPHs" on 4 Nov (MEASURES_CHECK C2); CPY side ≥ CPH side ----------------
EVALUATE
    UNION (
        CALCULATETABLE (
            ROW ( "Source", [P6 16A Source], "CPH", [P6 K3 Text], "CPHDetail", [P6 K3 Detail],
                "CPY", [P6 K3Y Text], "CPYDetail", [P6 K3Y Detail], "CPYColour", [P6 K3Y Colour] ),
            _kScope, TREATAS ( { "Facts" }, 'P1 Source'[Source] ) ),
        CALCULATETABLE (
            ROW ( "Source", [P6 16A Source], "CPH", [P6 K3 Text], "CPHDetail", [P6 K3 Detail],
                "CPY", [P6 K3Y Text], "CPYDetail", [P6 K3Y Detail], "CPYColour", [P6 K3Y Colour] ),
            _kScope, TREATAS ( { "CORTEX" }, 'P1 Source'[Source] ) ) )

// ---- Y2 tooltip rows (default source) -------------------------------------------------------------------------------
EVALUATE
    FILTER (
        SUMMARIZECOLUMNS ( DIM_COUNTERPARTY[CPY Label], DIM_COUNTERPARTY[CPH_Label], _kScope,
            "Status", [P6 K3Y Status], "Since", [P6 K3Y Since], "Util%", [P6 16A Util %],
            "UtilVsLimit", [P6 K3Y Util vs Limit], "Structure", [P6 K3Y Structure], "Flag", [P6 K3Y Flag] ),
        [Flag] = 1 )
    ORDER BY [Util%] DESC
