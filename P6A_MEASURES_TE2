defs.Add(new[] { @"P6 C2 PFE Proxy", @"P6\5 PFE and maturity", @"""€""#,0.0", @"", @"-- ESTIMATE, not 16A: SA-CCR add-on on live deals (booked since 2022) by remaining maturity, regulatory supervisory
-- factors (P6W SACCR), supervisory duration for rates / credit / GRI&T. No netting, no collateral: ranks, does not size.
VAR _a = [P6 AsOf]
VAR _sc =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" )
VAR _sel =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _dEnv =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
