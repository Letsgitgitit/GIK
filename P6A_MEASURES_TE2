def add(name, folder, fmt, expr, cat=""):
    M.append((name, folder, fmt, cat, expr.strip("\n")))


# ---------------------------------------------------------------- shared DAX fragments
def counted(a):
    """VAR block: _cnt = in-scope ids in context minus members of out-of-scope 16A envelopes at date var `a` (A3b)."""
    return f"""VAR _sc =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        DIM_COUNTERPARTY[HF Scope] = "Hedge fund" )
VAR _sel =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = "Hedge fund" ) )
VAR _dEnv =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] <= {a}, FACT_LIMIT_16A[SnapshotDate] > {a} - 31 )
VAR _out =
    CALCULATETABLE ( VALUES ( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] = _dEnv, FACT_LIMIT_16A[StructureType] = "Envelope",
        TREATAS ( _sel, FACT_LIMIT_16A[HeadOfficeSirisId] ),
        FILTER ( ALL ( FACT_LIMIT_16A[EnvelopeHolderId] ), NOT FACT_LIMIT_16A[EnvelopeHolderId] IN _sc ) )
VAR _cnt = EXCEPT ( _sel, _out )"""


WIN = "REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a )"
CNT = "KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) )"
NOSP = 'KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], "Sponsored" ) ) )'


def lim16(kind, date_expr, extra=""):
    """16A util or limit at date_expr, CORTEX when selected and available (P1 G1 rule), else facts."""
    fx = "16A Util" if kind == "Util" else "16A Limit"
    return f"""-- 16A {kind.lower()} on the last file in the 31 days to the date, HF scope, out-of-scope envelopes excluded (A3b).
-- Source switch (A4): CORTEX when chosen and CORTEX has a limit for the selection, else facts (as P1 G1).
VAR _a = {date_expr}
{counted("_a")}
VAR _cxL = CALCULATE ( [Cx 16A Limit], {WIN}, {CNT}{extra} )
VAR _useCx = [Src Selected] = "CORTEX" && NOT ISBLANK ( _cxL )
RETURN
    IF ( NOT ISBLANK ( _a ),
        IF ( _useCx,
            {"_cxL" if kind == "Limit" else f"COALESCE ( CALCULATE ( [Cx 16A Util], {WIN}, {CNT}{extra} ), 0 )"},
            CALCULATE ( [{fx}], {WIN}, {CNT}{extra} ) ) )"""


def facts(measure, date_expr, note):
    return f"""-- {note}
VAR _a = {date_expr}
{counted("_a")}
RETURN IF ( NOT ISBLANK ( _a ), CALCULATE ( [{measure}], {WIN}, {CNT} ) )"""


def repo_date(a):
    return f"""VAR _dr =
    CALCULATE ( MAX ( FACT_ALLREPO[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_ALLREPO[SnapshotDate] <= {a}, FACT_ALLREPO[SnapshotDate] > {a} - 31 )"""


def repo_sum(expr, date_expr, side, note):
    side_f = f', FACT_ALLREPO[BuySell] = "{side}"' if side else ""
    return f"""-- {note}
VAR _a = {date_expr}
{counted("_a")}
{repo_date("_a")}
RETURN
    IF ( NOT ISBLANK ( _dr ),
        CALCULATE ( {expr}, REMOVEFILTERS ( DIM_DATE ), FACT_ALLREPO[SnapshotDate] = _dr,
            FACT_ALLREPO[SLA_CateCode] = "07L"{side_f}, {NOSP}, {CNT} ) )"""


def s_side(date_var, extra=""):
    """filters for the 17B (S) collateral-received set at ALLREPO date var."""
    return (f'REMOVEFILTERS ( DIM_DATE ), FACT_ALLREPO[SnapshotDate] = {date_var}, FACT_ALLREPO[SLA_CateCode] = "07L", '
            f'FACT_ALLREPO[BuySell] = "S", {NOSP}, {CNT}{extra}')


