defs.Add(new[] { @"P6 V Has Issue", @"P6\4 NAV", @"0", @"", @"IF ( [P6 V Severity] > 0, 1, 0 )" });
defs.Add(new[] { @"P6 V Colour", @"P6\7 Format", @"", @"", @"VAR _s = [P6 V Severity]
