defs.Add(new[] { @"P5 Revenue", @"P5\1 Base", @"""€""#,0.0,,""m""", @"", @"-- THE P5 revenue rule (contract A3): Rev Revenue EUR (re-booked repos out) with the intra-group switch applied.
