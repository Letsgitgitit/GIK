defs.Add(new[] { @"P5 C2 Silent Limit", @"P5\4 Cards", @"""€""#,0.0,,,""bn""", @"", @"-- 16A limit (last 16A snapshot <= window end) of CPHs with no deal in the 12 complete months.
-- Trading test: any deal (net-negative traders are not silent, Q2), all rows, ignores Region, follows product filters.
-- Intra = Exclude: holders drop every CPH with an intra-group entity (contract 1.2).
VAR _mode = [P5 Intra Mode]
VAR _end = [Rev Window End]
VAR _s = [P5 W12 Start]
VAR _e = [P5 W12 End]
VAR _snap = CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS (), FACT_LIMIT_16A[SnapshotDate] <= _end )
VAR _trading =
    SELECTCOLUMNS (
        CALCULATETABLE (
            FILTER ( SUMMARIZE ( FACT_SALES, DIM_COUNTERPARTY[CPH_Id] ), LEN ( DIM_COUNTERPARTY[CPH_Id] ) > 0 ),
            REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _s, _e ),
            REMOVEFILTERS ( FACT_SALES[RegionName] ),
            FACT_SALES[IsRebooked] = FALSE () ),
        ""c"", DIM_COUNTERPARTY[CPH_Id] )
VAR _intra =
    SELECTCOLUMNS (
        CALCULATETABLE ( FILTER ( VALUES ( DIM_COUNTERPARTY[CPH_Id] ), LEN ( DIM_COUNTERPARTY[CPH_Id] ) > 0 ),
            REMOVEFILTERS ( DIM_COUNTERPARTY ), DIM_COUNTERPARTY[IsIntraGroup] = TRUE () ),
        ""c"", DIM_COUNTERPARTY[CPH_Id] )
VAR _holdersAll =
    SELECTCOLUMNS (
        CALCULATETABLE (
