        RETURN ABS ( FACT_SALES[NominalAmountEUR] ) * _sf * IF ( _ud = 1, ( 1 - EXP ( -0.05 * _y ) ) / 0.05, 1 ) )" });
defs.Add(new[] { @"P6 C2 PFE Proxy Cmp", @"P6\5 PFE and maturity", @"""€""#,0.0", @"", @"-- 11 Nov: the same estimate at the page compare date (A5: 1D / 1W / 1M): deals live then, maturity measured from then.
