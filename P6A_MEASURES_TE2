var dryRun = false;   // set to true to preview only

var home = Model.Tables["_Measures"];
var missing = new List<string>();
Func<string, string, bool> hasCol = (t, c) => Model.Tables.Contains(t) && Model.Tables[t].Columns.Contains(c);
foreach (var tc in new[] {
    new[] { "P5W IntraGroup", "Option" }, new[] { "P5W Map Period", "Period" },
    new[] { "P5W Detail", "P5W Detail Order" }, new[] { "P5W Seller", "P5W Seller Order" },
    new[] { "DIM_PRODUCTLINE", "Family" }, new[] { "DIM_PRODUCTLINE", "ProductLineGroupName" },
    new[] { "FACT_SALES", "Tenor Bucket" }, new[] { "FACT_SALES", "IsRebooked" }, new[] { "FACT_SALES", "DealLifeDays" },
    new[] { "FACT_SALES", "NominalAmountEUR" }, new[] { "FACT_SALES", "MarkUpEUR" }, new[] { "FACT_SALES", "SourceApplication" },
    new[] { "FACT_SALES", "ProductLineLongName" }, new[] { "FACT_SALES", "InstrumentLongName" },
    new[] { "FACT_SALES", "DeskShortName" }, new[] { "FACT_SALES", "SalesName" }, new[] { "FACT_SALES", "RegionName" },
    new[] { "DIM_COUNTERPARTY", "IsIntraGroup" }, new[] { "DIM_COUNTERPARTY", "CPH_Id" }, new[] { "DIM_COUNTERPARTY", "CPH_Label" }, new[] { "DIM_COUNTERPARTY", "CPY Label" }, new[] { "DIM_COUNTERPARTY", "HeadOfficeSirisId" }, new[] { "P5W Concentration", "Option" },
    new[] { "DIM_DATE", "YearMonth" }, new[] { "FACT_LIMIT_16A", "StructureType" }, new[] { "FACT_LIMIT_16A", "Amount" } })
    if (!hasCol(tc[0], tc[1])) missing.Add("column " + tc[0] + "[" + tc[1] + "]");
foreach (var n in new[] { "Rev Revenue EUR", "Rev Window Start", "Rev Window End", "Asof Sales Date", "16A Limit" })
    if (!home.Measures.Contains(n)) missing.Add("P1 measure [" + n + "]");

