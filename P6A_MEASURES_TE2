            COALESCE ( CALCULATE ( [Cx 16A Util], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a ), KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) ) ), 0 ),
            CALCULATE ( [16A Util], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a ), KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) ) ) ) )" });
