            VAR _ps = MAXX ( FILTER ( _t, DIM_DATE[YearMonth] = _pv ), [@s] )
            RETURN NOT ISBLANK ( _pv ) && [@s] > _ps ) ) + 0
RETURN
    IF ( COUNTROWS ( _t ) >= 2,
