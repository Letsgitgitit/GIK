foreach (var d in defs)
    foreach (var mm in Model.AllMeasures.Where(x => x.Name == d[0] && x.Table.Name != "_Measures"))
        missing.Add("name clash: [" + d[0] + "] already exists in table " + mm.Table.Name);
if (missing.Count > 0) {
    Info("STOPPED - nothing changed.\n" + string.Join("\n", missing));
    return;
}

int created = 0, updated = 0, same = 0;
var rep = new System.Text.StringBuilder();
foreach (var d in defs) {
    var exists = home.Measures.Contains(d[0]);
    if (exists) {
        var m = home.Measures[d[0]];
        bool eq = m.Expression.Replace("\r", "").Trim() == d[4].Replace("\r", "").Trim()
                  && m.DisplayFolder == d[1] && (m.FormatString ?? "") == d[2];
        if (eq) { same++; continue; }
        if (!dryRun) { m.Expression = d[4]; m.DisplayFolder = d[1]; m.FormatString = d[2]; if (d[3] != "") m.DataCategory = d[3]; }
        updated++; rep.AppendLine((dryRun ? "WOULD UPDATE  " : "updated  ") + d[0]);
    } else {
        if (!dryRun) {
            var m = home.AddMeasure(d[0], d[4], d[1]);
            m.FormatString = d[2];
            if (d[3] != "") m.DataCategory = d[3];
        }
        created++; rep.AppendLine((dryRun ? "WOULD CREATE  " : "created  ") + d[0]);
    }
}
Info("P5W_MEASURES  BUILD 2026-11-04b" + (dryRun ? "   (DRY RUN - nothing changed)" : "") + "\n"
     + "created " + created + " · updated " + updated + " · unchanged " + same + " (of " + defs.Count + ")\n\n"
     + rep.ToString() + "\n"
     + (dryRun ? "Set dryRun = false and run again to apply." : "Next: Ctrl+S, then P5W_MEASURES_CHECK.dax."));
