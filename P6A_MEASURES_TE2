defs.Add(new[] { @"P5 Intra Mode", @"P5\1 Base", @"", @"", @"-- Intra-group switch (B4). Default Exclude: the bank's own group (DIM_COUNTERPARTY[IsIntraGroup]) leaves every P5 figure.
