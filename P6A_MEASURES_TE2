defs.Add(new[] { @"P6 NAV 1M", @"P6\4 NAV", @"+0.0%;-0.0%;0.0%", @"", @"-- 1-month NAV change at the NAV month.
-- NAV-weighted: sum of NAV now / sum of NAV before - 1, over funds with both values (USD, as reported).
VAR _n = [P6 NAV Month]
VAR _r =
    CALCULATETABLE ( FACT_HF_NAV, REMOVEFILTERS ( DIM_DATE ), FACT_HF_NAV[MonthEnd] = _n,
