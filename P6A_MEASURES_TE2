defs.Add(new[] { @"P6 V Since", @"P6\4 NAV", @"mmm yyyy", @"", @"-- First month of the uninterrupted run of the current issue, followed by entity id across fund renames (name if unmapped).
VAR _t = [P6 NAV Threshold]
VAR _n = [P6 NAV Month]
VAR _cur = [P6 V Severity]
VAR _now =
    CALCULATETABLE ( FACT_HF_NAV, REMOVEFILTERS ( DIM_DATE ), FACT_HF_NAV[MonthEnd] = _n,
        KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _id = MAXX ( _now, FACT_HF_NAV[HeadOfficeSirisId] )
VAR _nm = MAXX ( _now, FACT_HF_NAV[Fund_Name] )
VAR _hist =
    FILTER ( ALL ( FACT_HF_NAV ),
        IF ( ISBLANK ( _id ), FACT_HF_NAV[Fund_Name] = _nm, FACT_HF_NAV[HeadOfficeSirisId] = _id )
            && FACT_HF_NAV[MonthEnd] <= _n )
VAR _sev =
    ADDCOLUMNS ( _hist, ""@s"",
            VAR _sm = FACT_HF_NAV[MonthEnd]
            VAR _sid = FACT_HF_NAV[HeadOfficeSirisId]
            VAR _snm = FACT_HF_NAV[Fund_Name]
            VAR _sc1 = FACT_HF_NAV[NAVChg_1M]
            VAR _scov = FACT_HF_NAV[Covenant]
            VAR _sval = FACT_HF_NAV[ValidityDate]
            VAR _sdd = FACT_HF_NAV[LastDDDate]
            VAR _sneg =
                NOT ISBLANK ( _sc1 ) && _sc1 < 0
                    && COUNTROWS (
                        FILTER ( ALL ( FACT_HF_NAV ),
                            IF ( ISBLANK ( _sid ), FACT_HF_NAV[Fund_Name] = _snm, FACT_HF_NAV[HeadOfficeSirisId] = _sid )
                                && FACT_HF_NAV[MonthEnd] > EOMONTH ( _sm, -3 ) && FACT_HF_NAV[MonthEnd] <= EOMONTH ( _sm, -1 )
                                && FACT_HF_NAV[NAVChg_1M] < 0 ) ) >= 2
            RETURN
                SWITCH ( TRUE (),
                    _scov = ""Breach"", 7,
                    _scov = ""Breach (Conditional)"", 6,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= -0.10, 5,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= _t, 4,
                    NOT ISBLANK ( _sdd ) && _sdd < EDATE ( _sm, -12 ), 3,
                    _sneg, 2,
                    NOT ISBLANK ( _sval ) && _sval < _sm, 1,
                    0 ) )
