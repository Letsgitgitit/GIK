RETURN
    IF ( _cur > 0 && COUNTROWS ( _now ) > 0,
        MINX ( FILTER ( _sev, FACT_HF_NAV[MonthEnd] > COALESCE ( _lastDiff, DATE ( 1900, 1, 1 ) ) ), FACT_HF_NAV[MonthEnd] ) )" });
