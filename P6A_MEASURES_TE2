NAV_ROWS = """CALCULATETABLE ( FACT_HF_NAV, REMOVEFILTERS ( DIM_DATE ), {f},
        KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = "Hedge fund" ) )"""


def nav_chg(col, rowfilter, note):
    return f"""-- {note}
-- NAV-weighted: sum of NAV now / sum of NAV before - 1, over funds with both values (USD, as reported).
{rowfilter}
VAR _ok = FILTER ( _r, NOT ISBLANK ( FACT_HF_NAV[NAV_Cur] ) && NOT ISBLANK ( FACT_HF_NAV[{col}] ) && FACT_HF_NAV[{col}] > -1 )
VAR _now = SUMX ( _ok, FACT_HF_NAV[NAV_Cur] )
VAR _bef = SUMX ( _ok, DIVIDE ( FACT_HF_NAV[NAV_Cur], 1 + FACT_HF_NAV[{col}] ) )
RETURN IF ( _bef > 0, _now / _bef - 1 )"""


ROWS_AT_NAV = "VAR _n = [P6 NAV Month]\nVAR _r =\n    " + NAV_ROWS.format(f="FACT_HF_NAV[MonthEnd] = _n")
ROWS_AT_X = ("VAR _x = MAX ( DIM_DATE[Date] )\nVAR _x0 = EOMONTH ( _x, -1 )\nVAR _x1 = EOMONTH ( _x, 0 )\nVAR _r =\n    "
             + NAV_ROWS.format(f="FACT_HF_NAV[MonthEnd] > _x0, FACT_HF_NAV[MonthEnd] <= _x1"))

