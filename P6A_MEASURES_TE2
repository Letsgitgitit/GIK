defs.Add(new[] { @"P6 R2 Subtitle", @"P6\6 Repo", @"", @"", @"VAR _a = [P6 AsOf]
VAR _rd = [P6 R Range Days]
VAR _from = MAX ( _a - _rd, DATE ( 2023, 1, 1 ) )
VAR _t =
    FILTER (
