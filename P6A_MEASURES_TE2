                    ""Rates"", CALCULATE ( SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), ABS ( FACT_SALES[NominalAmountEUR] ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), REMOVEFILTERS ( DIM_PRODUCTLINE ), TREATAS ( _cnt, FACT_SALES[RicosCode] ), FACT_SALES[IsRebooked] = FALSE (), FACT_SALES[NominalAmountEUR] <= 5E10, FACT_SALES[NominalAmountEUR] >= -5E10, NOT FACT_SALES[ProductLineGroupName] IN { ""GRI FIXED INCOME"", ""SCARCE RESOURCES AND XVA TRADING"" }, FACT_SALES[DealDate] > _dp, FACT_SALES[DealDate] <= _d, TREATAS ( { ""Rates"" }, DIM_PRODUCTLINE[Family] ) ),
                    ""FX"", CALCULATE ( SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), ABS ( FACT_SALES[NominalAmountEUR] ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), REMOVEFILTERS ( DIM_PRODUCTLINE ), TREATAS ( _cnt, FACT_SALES[RicosCode] ), FACT_SALES[IsRebooked] = FALSE (), FACT_SALES[NominalAmountEUR] <= 5E10, FACT_SALES[NominalAmountEUR] >= -5E10, NOT FACT_SALES[ProductLineGroupName] IN { ""GRI FIXED INCOME"", ""SCARCE RESOURCES AND XVA TRADING"" }, FACT_SALES[DealDate] > _dp, FACT_SALES[DealDate] <= _d, TREATAS ( { ""FX"" }, DIM_PRODUCTLINE[Family] ) ),
                    ""Credit"", CALCULATE ( SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), ABS ( FACT_SALES[NominalAmountEUR] ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), REMOVEFILTERS ( DIM_PRODUCTLINE ), TREATAS ( _cnt, FACT_SALES[RicosCode] ), FACT_SALES[IsRebooked] = FALSE (), FACT_SALES[NominalAmountEUR] <= 5E10, FACT_SALES[NominalAmountEUR] >= -5E10, NOT FACT_SALES[ProductLineGroupName] IN { ""GRI FIXED INCOME"", ""SCARCE RESOURCES AND XVA TRADING"" }, FACT_SALES[DealDate] > _dp, FACT_SALES[DealDate] <= _d, TREATAS ( { ""Credit & securitisation"" }, DIM_PRODUCTLINE[Family] ) ),
                    ""Repo"", CALCULATE ( SUMX ( VALUES ( FACT_ALLREPO[CCCTradeKey] ), VAR _m = CALCULATE ( MAX ( FACT_ALLREPO[MaturityDate] ) ) VAR _t = CALCULATE ( MAX ( FACT_ALLREPO[TradeDate] ) ) RETURN IF ( NOT ISBLANK ( _m ) && _m > _t && _m < DATE ( 2099, 1, 1 ), ABS ( CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) ) ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), TREATAS ( _cnt, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SLA_CateCode] = ""07L"", KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Sponsored"" ) ) ), FACT_ALLREPO[BuySell] = ""B"", FACT_ALLREPO[TradeDate] > _dp, FACT_ALLREPO[TradeDate] <= _d, FACT_ALLREPO[SnapshotDate] > _dp, FACT_ALLREPO[SnapshotDate] <= _sx2 ),
                    ""Rev repo"", CALCULATE ( SUMX ( VALUES ( FACT_ALLREPO[CCCTradeKey] ), VAR _m = CALCULATE ( MAX ( FACT_ALLREPO[MaturityDate] ) ) VAR _t = CALCULATE ( MAX ( FACT_ALLREPO[TradeDate] ) ) RETURN IF ( NOT ISBLANK ( _m ) && _m > _t && _m < DATE ( 2099, 1, 1 ), ABS ( CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) ) ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), TREATAS ( _cnt, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SLA_CateCode] = ""07L"", KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Sponsored"" ) ) ), FACT_ALLREPO[BuySell] = ""S"", FACT_ALLREPO[TradeDate] > _dp, FACT_ALLREPO[TradeDate] <= _d, FACT_ALLREPO[SnapshotDate] > _dp, FACT_ALLREPO[SnapshotDate] <= _sx2 ),
                    CALCULATE ( SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), ABS ( FACT_SALES[NominalAmountEUR] ) ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), REMOVEFILTERS ( DIM_PRODUCTLINE ), TREATAS ( _cnt, FACT_SALES[RicosCode] ), FACT_SALES[IsRebooked] = FALSE (), FACT_SALES[NominalAmountEUR] <= 5E10, FACT_SALES[NominalAmountEUR] >= -5E10, NOT FACT_SALES[ProductLineGroupName] IN { ""GRI FIXED INCOME"", ""SCARCE RESOURCES AND XVA TRADING"" }, FACT_SALES[DealDate] > _dp, FACT_SALES[DealDate] <= _d, TREATAS ( { ""Rates"", ""FX"", ""Credit & securitisation"" }, DIM_PRODUCTLINE[Family] ) ) )
VAR _f = IF ( _p IN { ""FX"", ""Repo"", ""Rev repo"" }, 12, 1 )
