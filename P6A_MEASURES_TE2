defs.Add(new[] { @"P5 Z1 Sparkline", @"P5\2 Product", @"", @"ImageUrl", @"-- 26 weekly revenue points ending at the window end; SVG 80 x 18 (integer coordinates: no decimal separator issue).
VAR _e = [Rev Window End]
VAR _days =
    CALCULATETABLE ( VALUES ( DIM_DATE[Date] ), REMOVEFILTERS ( DIM_DATE ),
        DATESBETWEEN ( DIM_DATE[Date], _e - 181, _e ) )
VAR _dRev =
    ADDCOLUMNS ( _days,
        ""@w"", 25 - INT ( ( _e - DIM_DATE[Date] ) / 7 ),
        ""@r"", VAR _dd = DIM_DATE[Date]
              RETURN CALCULATE ( [P5 Revenue], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[Date] = _dd ) )
VAR _pts =
    ADDCOLUMNS ( GENERATESERIES ( 0, 25, 1 ),
        ""@v"", VAR _x = [Value] RETURN SUMX ( FILTER ( _dRev, [@w] = _x ), [@r] ) + 0 )
VAR _mn = MINX ( _pts, [@v] )
VAR _mx = MAXX ( _pts, [@v] )
VAR _rng = IF ( _mx = _mn, 1, _mx - _mn )
VAR _col = IF ( [P5 vs LY %] < 0, ""%23E8597A"", ""%2346B6C9"" )
VAR _poly =
    CONCATENATEX ( _pts,
        FORMAT ( [Value] * 4, ""0"" ) & "","" & FORMAT ( 38 - ROUND ( ( [@v] - _mn ) / _rng * 36, 0 ), ""0"" ),
        "" "", [Value], ASC )
RETURN
    IF ( NOT ISBLANK ( _e ) && ( _mx <> 0 || _mn <> 0 ),
        ""data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='18' viewBox='0 0 100 40' preserveAspectRatio='none'>""
            & ""<polyline fill='none' stroke='"" & _col & ""' stroke-width='2.5' points='"" & _poly & ""'/></svg>"" )" });
