VAR _now = SUMX ( _ok, FACT_HF_NAV[NAV_Cur] )
VAR _bef = SUMX ( _ok, DIVIDE ( FACT_HF_NAV[NAV_Cur], 1 + FACT_HF_NAV[NAVChg_1M] ) )
