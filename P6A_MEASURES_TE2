def act(kind, s_, e_, x):
    """Scalar DAX for product var _p over (s_, e_]. kind: N notional, D deals, TN tenor numerator, TD tenor denominator.
    Sales (Rates / FX / Credit) by DealDate; repo by TradeDate on ALLREPO (B = Repo 17A, S = Rev repo 17B), one trade =
    one TransactionId (it repeats on every snapshot while live). x = suffix for unique VAR names."""
    sd = f"FACT_SALES[DealDate] > {s_}, FACT_SALES[DealDate] <= {e_}"
    if kind == "N":
        se = "SUMX ( FACT_SALES, ABS ( FACT_SALES[NominalAmountEUR] ) )"
        re_ = "SUMX ( VALUES ( FACT_ALLREPO[TransactionId] ), CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) )"
    elif kind == "D":
        se = "COUNTROWS ( FACT_SALES )"
        re_ = "DISTINCTCOUNT ( FACT_ALLREPO[TransactionId] )"
    elif kind == "TN":
        se = ("SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), "
              "ABS ( FACT_SALES[NominalAmountEUR] ) * ( FACT_SALES[MaturityDate] - FACT_SALES[DealDate] ) / 365.25 )")
        re_ = ("SUMX ( VALUES ( FACT_ALLREPO[TransactionId] ), VAR _m = CALCULATE ( MAX ( FACT_ALLREPO[MaturityDate] ) ) "
               "VAR _t = CALCULATE ( MAX ( FACT_ALLREPO[TradeDate] ) ) RETURN IF ( NOT ISBLANK ( _m ) && _m > _t && _m < DATE ( 2099, 1, 1 ), "
               "ABS ( CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) ) * ( _m - _t ) / 365.25 ) )")
    else:  # TD
        se = ("SUMX ( FILTER ( FACT_SALES, FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ) && FACT_SALES[MaturityDate] > FACT_SALES[DealDate] ), "
              "ABS ( FACT_SALES[NominalAmountEUR] ) )")
        re_ = ("SUMX ( VALUES ( FACT_ALLREPO[TransactionId] ), VAR _m = CALCULATE ( MAX ( FACT_ALLREPO[MaturityDate] ) ) "
               "VAR _t = CALCULATE ( MAX ( FACT_ALLREPO[TradeDate] ) ) RETURN IF ( NOT ISBLANK ( _m ) && _m > _t && _m < DATE ( 2099, 1, 1 ), "
               "ABS ( CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) ) ) )")
    if kind == "N":
        re_ = re_.replace("CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) )", "ABS ( CALCULATE ( MAX ( FACT_ALLREPO[CashAmount_EUR] ) ) )")

    def sales(fam):
        return f"CALCULATE ( {se}, {SALES_F}, {sd}, TREATAS ( {FAMS[fam]}, DIM_PRODUCTLINE[Family] ) )"

    def repo(side):
        return (f"CALCULATE ( {re_}, {REPO_F}, FACT_ALLREPO[BuySell] = \"{side}\", FACT_ALLREPO[TradeDate] > {s_}, "
                f"FACT_ALLREPO[TradeDate] <= {e_}, FACT_ALLREPO[SnapshotDate] > {s_}, FACT_ALLREPO[SnapshotDate] <= _sx{x} )")
    return f"""VAR _sx{x} = {e_} + 5
            RETURN
                SWITCH ( _p,
                    "Rates", {sales("Rates")},
                    "FX", {sales("FX")},
                    "Credit", {sales("Credit")},
                    "Repo", {repo("B")},
                    "Rev repo", {repo("S")},
                    COALESCE ( {sales("All")}, 0 ) + COALESCE ( {repo("B")}, 0 ) + COALESCE ( {repo("S")}, 0 ) )"""


