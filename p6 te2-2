defs.Add(new[] { @"P6 C2 PFE Proxy", @"P6\5 PFE and maturity", @"""€""#,0.0,,""m""", @"", @"-- ESTIMATE, not 16A: SA-CCR add-on on live deals (booked since 2022) by remaining maturity, regulatory supervisory
-- factors (P6W SACCR), supervisory duration for rates / credit / GRI&T. No netting, no collateral: ranks, does not size.
VAR _a = [P6 AsOf]
VAR _sc =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" )
VAR _sel =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _dEnv =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] <= _a, FACT_LIMIT_16A[SnapshotDate] > _a - 31 )
VAR _out =
    CALCULATETABLE ( VALUES ( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] = _dEnv, FACT_LIMIT_16A[StructureType] = ""Envelope"",
        TREATAS ( _sel, FACT_LIMIT_16A[HeadOfficeSirisId] ),
        FILTER ( ALL ( FACT_LIMIT_16A[EnvelopeHolderId] ), NOT FACT_LIMIT_16A[EnvelopeHolderId] IN _sc ) )
VAR _cnt = EXCEPT ( _sel, _out )
VAR _lo = SELECTEDVALUE ( 'P6W Maturity Bucket'[LoYears], 0 )
VAR _hi = SELECTEDVALUE ( 'P6W Maturity Bucket'[HiYears], 99 )
VAR _rows =
    FILTER (
        CALCULATETABLE ( FACT_SALES, REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
            TREATAS ( _cnt, FACT_SALES[RicosCode] ),
            FACT_SALES[DealDate] <= _a,
            FACT_SALES[MaturityDate] > _a + _lo * 365.25, FACT_SALES[MaturityDate] <= _a + _hi * 365.25,
            FACT_SALES[MaturityDate] < DATE ( 2099, 1, 1 ), FACT_SALES[IsRebooked] = FALSE (),
            NOT FACT_SALES[ProductLineGroupName] IN { ""GRI FIXED INCOME"", ""SCARCE RESOURCES AND XVA TRADING"" } ),
        ABS ( FACT_SALES[NominalAmountEUR] ) <= 5E10 )
RETURN
    SUMX ( _rows,
        VAR _y = ( FACT_SALES[MaturityDate] - _a ) / 365.25
        VAR _f = COALESCE ( LOOKUPVALUE ( DIM_PRODUCTLINE[Family], DIM_PRODUCTLINE[ProductLineGroupName], FACT_SALES[ProductLineGroupName] ), ""Unmapped"" )
        VAR _sf = COALESCE ( LOOKUPVALUE ( 'P6W SACCR'[SF], 'P6W SACCR'[Family], _f ), 0.15 )
        VAR _ud = LOOKUPVALUE ( 'P6W SACCR'[UseDuration], 'P6W SACCR'[Family], _f )
        RETURN ABS ( FACT_SALES[NominalAmountEUR] ) * _sf * IF ( _ud = 1, ( 1 - EXP ( -0.05 * _y ) ) / 0.05, 1 ) )" });
