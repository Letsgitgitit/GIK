VAR _sel =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _dEnv =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] <= _a, FACT_LIMIT_16A[SnapshotDate] > _a - 31 )
VAR _out =
    CALCULATETABLE ( VALUES ( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] = _dEnv, FACT_LIMIT_16A[StructureType] = ""Envelope"",
        TREATAS ( _sel, FACT_LIMIT_16A[HeadOfficeSirisId] ),
        FILTER ( ALL ( FACT_LIMIT_16A[EnvelopeHolderId] ), NOT FACT_LIMIT_16A[EnvelopeHolderId] IN _sc ) )
VAR _cnt = EXCEPT ( _sel, _out )
VAR _cxL = CALCULATE ( [Cx 16A Limit], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a ), KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) ) )
VAR _useCx = [Src Selected] = ""CORTEX"" && NOT ISBLANK ( _cxL )
RETURN
    IF ( NOT ISBLANK ( _a ),
        IF ( _useCx,
            COALESCE ( CALCULATE ( [Cx 16A Util], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a ), KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) ) ), 0 ),
            CALCULATE ( [16A Util], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _a - 31, _a ), KEEPFILTERS ( TREATAS ( _cnt, DIM_COUNTERPARTY[HeadOfficeSirisId] ) ) ) ) )" });
defs.Add(new[] { @"P6 FX At NAV", @"P6\4 NAV", @"0.0000", @"", @"-- EUR/USD on the last clean rate on or before the NAV month-end (DIM_FX_EURUSD: USD per EUR).
