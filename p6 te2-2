defs.Add(new[] { @"P6 R3 Corr", @"P6\6 Repo", @"0.00", @"", @"-- Pearson correlation over the 12 NAV months: NAV 1M in month t vs the change of the C-or-lower collateral share from
-- t to t+1. Blank with fewer than 6 pairs.
VAR _n = [P6 NAV Month]
VAR _t =
    FILTER (
        ADDCOLUMNS (
            ADDCOLUMNS ( GENERATESERIES ( 0, 11, 1 ), ""@m"", EOMONTH ( _n, -[Value] ) ),
            ""@x"", VAR _m = [@m] RETURN CALCULATE ( [P6 NAV 1M At], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[Date] = _m ),
            ""@y"",
                VAR _m = [@m]
                VAR _s0 = CALCULATE ( [P6 R LowGrade At], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[Date] = _m )
                VAR _m1 = EOMONTH ( _m, 1 )
                VAR _s1 = CALCULATE ( [P6 R LowGrade At], REMOVEFILTERS ( DIM_DATE ), DIM_DATE[Date] = _m1 )
                RETURN IF ( NOT ISBLANK ( _s0 ) && NOT ISBLANK ( _s1 ), _s1 - _s0 ) ),
        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] ) )
VAR _k = COUNTROWS ( _t )
VAR _mx = AVERAGEX ( _t, [@x] )
VAR _my = AVERAGEX ( _t, [@y] )
VAR _cov = SUMX ( _t, ( [@x] - _mx ) * ( [@y] - _my ) )
VAR _vx = SUMX ( _t, ( [@x] - _mx ) ^ 2 )
VAR _vy = SUMX ( _t, ( [@y] - _my ) ^ 2 )
RETURN IF ( _k >= 6 && _vx > 0 && _vy > 0, _cov / SQRT ( _vx * _vy ) )" });
