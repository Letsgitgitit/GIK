defs.Add(new[] { @"P6 V Severity", @"P6\4 NAV", @"0", @"", @"-- Worst review issue at the NAV month over the funds in context: 7 Breach · 6 Breach (Conditional) · 5 NAV 1M ≤ -10 %
-- · 4 NAV 1M ≤ threshold · 3 annual due diligence missed (> 12 months) · 2 three negative months
-- · 1 validity date passed (soft enforcement, Will 6 Nov: shown, not escalated) · 0 none.
VAR _t = [P6 NAV Threshold]
VAR _n = [P6 NAV Month]
VAR _r =
    CALCULATETABLE ( FACT_HF_NAV, REMOVEFILTERS ( DIM_DATE ), FACT_HF_NAV[MonthEnd] = _n,
        KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
RETURN
    MAXX ( _r,
            VAR _sm = FACT_HF_NAV[MonthEnd]
            VAR _sid = FACT_HF_NAV[HeadOfficeSirisId]
            VAR _snm = FACT_HF_NAV[Fund_Name]
            VAR _sc1 = FACT_HF_NAV[NAVChg_1M]
            VAR _scov = FACT_HF_NAV[Covenant]
            VAR _sval = FACT_HF_NAV[ValidityDate]
            VAR _sdd = FACT_HF_NAV[LastDDDate]
            VAR _sneg =
                NOT ISBLANK ( _sc1 ) && _sc1 < 0
                    && COUNTROWS (
                        FILTER ( ALL ( FACT_HF_NAV ),
                            IF ( ISBLANK ( _sid ), FACT_HF_NAV[Fund_Name] = _snm, FACT_HF_NAV[HeadOfficeSirisId] = _sid )
                                && FACT_HF_NAV[MonthEnd] > EOMONTH ( _sm, -3 ) && FACT_HF_NAV[MonthEnd] <= EOMONTH ( _sm, -1 )
                                && FACT_HF_NAV[NAVChg_1M] < 0 ) ) >= 2
            RETURN
                SWITCH ( TRUE (),
                    _scov = ""Breach"", 7,
                    _scov = ""Breach (Conditional)"", 6,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= -0.10, 5,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= _t, 4,
                    NOT ISBLANK ( _sdd ) && _sdd < EDATE ( _sm, -12 ), 3,
                    _sneg, 2,
                    NOT ISBLANK ( _sval ) && _sval < _sm, 1,
                    0 ) )" });
defs.Add(new[] { @"P6 V Issue", @"P6\4 NAV", @"", @"", @"SWITCH ( [P6 V Severity],
    7, ""Breach"", 6, ""Breach (cond.)"", 5, ""NAV ≤ -10 % 1M"", 4, ""NAV ≤ "" & FORMAT ( [P6 NAV Threshold], ""0%"" ) & "" 1M"",
    3, ""DD > 12 months"", 2, ""3 negative months"", 1, ""Validity passed (soft)"", BLANK () )" });
defs.Add(new[] { @"P6 V Has Issue", @"P6\4 NAV", @"0", @"", @"IF ( [P6 V Severity] > 0, 1, 0 )" });
defs.Add(new[] { @"P6 V Colour", @"P6\7 Format", @"", @"", @"VAR _s = [P6 V Severity]
RETURN SWITCH ( TRUE (), ISBLANK ( _s ), ""#8A97AB"", _s >= 6, ""#E8597A"", _s >= 2, ""#E0A44B"", _s = 1, ""#8A97AB"", ""#56C08D"" )" });
defs.Add(new[] { @"P6 V Since", @"P6\4 NAV", @"mmm yyyy", @"", @"-- First month of the uninterrupted run of the current issue, followed by entity id across fund renames (name if unmapped).
VAR _t = [P6 NAV Threshold]
VAR _n = [P6 NAV Month]
VAR _cur = [P6 V Severity]
VAR _now =
    CALCULATETABLE ( FACT_HF_NAV, REMOVEFILTERS ( DIM_DATE ), FACT_HF_NAV[MonthEnd] = _n,
        KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _id = MAXX ( _now, FACT_HF_NAV[HeadOfficeSirisId] )
VAR _nm = MAXX ( _now, FACT_HF_NAV[Fund_Name] )
VAR _hist =
    FILTER ( ALL ( FACT_HF_NAV ),
        IF ( ISBLANK ( _id ), FACT_HF_NAV[Fund_Name] = _nm, FACT_HF_NAV[HeadOfficeSirisId] = _id )
            && FACT_HF_NAV[MonthEnd] <= _n )
VAR _sev =
    ADDCOLUMNS ( _hist, ""@s"",
            VAR _sm = FACT_HF_NAV[MonthEnd]
            VAR _sid = FACT_HF_NAV[HeadOfficeSirisId]
            VAR _snm = FACT_HF_NAV[Fund_Name]
            VAR _sc1 = FACT_HF_NAV[NAVChg_1M]
            VAR _scov = FACT_HF_NAV[Covenant]
            VAR _sval = FACT_HF_NAV[ValidityDate]
            VAR _sdd = FACT_HF_NAV[LastDDDate]
            VAR _sneg =
                NOT ISBLANK ( _sc1 ) && _sc1 < 0
                    && COUNTROWS (
                        FILTER ( ALL ( FACT_HF_NAV ),
                            IF ( ISBLANK ( _sid ), FACT_HF_NAV[Fund_Name] = _snm, FACT_HF_NAV[HeadOfficeSirisId] = _sid )
                                && FACT_HF_NAV[MonthEnd] > EOMONTH ( _sm, -3 ) && FACT_HF_NAV[MonthEnd] <= EOMONTH ( _sm, -1 )
                                && FACT_HF_NAV[NAVChg_1M] < 0 ) ) >= 2
            RETURN
                SWITCH ( TRUE (),
                    _scov = ""Breach"", 7,
                    _scov = ""Breach (Conditional)"", 6,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= -0.10, 5,
                    NOT ISBLANK ( _sc1 ) && _sc1 <= _t, 4,
                    NOT ISBLANK ( _sdd ) && _sdd < EDATE ( _sm, -12 ), 3,
                    _sneg, 2,
                    NOT ISBLANK ( _sval ) && _sval < _sm, 1,
                    0 ) )
VAR _lastDiff = MAXX ( FILTER ( _sev, [@s] <> _cur ), FACT_HF_NAV[MonthEnd] )
RETURN
    IF ( _cur > 0 && COUNTROWS ( _now ) > 0,
        MINX ( FILTER ( _sev, FACT_HF_NAV[MonthEnd] > COALESCE ( _lastDiff, DATE ( 1900, 1, 1 ) ) ), FACT_HF_NAV[MonthEnd] ) )" });
defs.Add(new[] { @"P6 M Covenant", @"P6\3 Movers", @"", @"", @"VAR _s = [P6 V Severity]
-- Validity passed alone (severity 1, soft enforcement) does not escalate the CPH: shown as ""OK*"".
RETURN SWITCH ( TRUE (), ISBLANK ( _s ), BLANK (), _s = 7, ""Breach"", _s = 6, ""Breach (C)"", _s >= 2, ""Review"", _s = 1, ""OK*"", ""OK"" )" });
