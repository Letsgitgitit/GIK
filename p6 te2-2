defs.Add(new[] { @"P6 M Downgraded", @"P6\3 Movers", @"0", @"", @"VAR _a = [P6 AsOf]
VAR _sc =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" )
VAR _sel =
    CALCULATETABLE ( VALUES ( DIM_COUNTERPARTY[HeadOfficeSirisId] ), KEEPFILTERS ( DIM_COUNTERPARTY[HF Scope] = ""Hedge fund"" ) )
VAR _dEnv =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] <= _a, FACT_LIMIT_16A[SnapshotDate] > _a - 31 )
VAR _out =
    CALCULATETABLE ( VALUES ( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] = _dEnv, FACT_LIMIT_16A[StructureType] = ""Envelope"",
        TREATAS ( _sel, FACT_LIMIT_16A[HeadOfficeSirisId] ),
        FILTER ( ALL ( FACT_LIMIT_16A[EnvelopeHolderId] ), NOT FACT_LIMIT_16A[EnvelopeHolderId] IN _sc ) )
VAR _cnt = EXCEPT ( _sel, _out )
VAR _rows =
    CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( FACT_LIMIT_16A, FACT_LIMIT_16A[HeadOfficeSirisId], FACT_LIMIT_16A[Rating] ),
            ""@u"", CALCULATE ( MAX ( FACT_LIMIT_16A[Utilisation] ) ) ),
        REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), FACT_LIMIT_16A[SnapshotDate] = _dEnv,
        TREATAS ( _cnt, FACT_LIMIT_16A[HeadOfficeSirisId] ) )
VAR _dOld =
    CALCULATE ( MAX ( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ),
        FACT_LIMIT_16A[SnapshotDate] <= _a - 30 )
VAR _old =
    CALCULATETABLE ( SUMMARIZE ( FACT_LIMIT_16A, FACT_LIMIT_16A[HeadOfficeSirisId], FACT_LIMIT_16A[Rating] ),
        REMOVEFILTERS ( DIM_DATE ), REMOVEFILTERS ( DIM_COUNTERPARTY ), FACT_LIMIT_16A[SnapshotDate] = _dOld,
        TREATAS ( _cnt, FACT_LIMIT_16A[HeadOfficeSirisId] ) )
VAR _ord = ""|A+|A|B+|B|C+|C|C-|D+|D|D-|E+|E|E-|F|Z|""
VAR _down =
    FILTER ( _rows,
        VAR _i = FACT_LIMIT_16A[HeadOfficeSirisId]
        VAR _rn = FACT_LIMIT_16A[Rating]
        VAR _ro = MAXX ( FILTER ( _old, FACT_LIMIT_16A[HeadOfficeSirisId] = _i ), FACT_LIMIT_16A[Rating] )
        VAR _pn = SEARCH ( ""|"" & _rn & ""|"", _ord, 1, 0 )
        VAR _po = SEARCH ( ""|"" & _ro & ""|"", _ord, 1, 0 )
        RETURN NOT ISBLANK ( _ro ) && _pn > 0 && _po > 0 && _pn > _po )
RETURN IF ( COUNTROWS ( _down ) > 0, 1, 0 )" });
defs.Add(new[] { @"P6 M Rating", @"P6\3 Movers", @"", @"", @"VAR _a = [P6 AsOf]
