defs.Add(new[] { @"P6 N Util", @"P6\4 NAV", @"""€""#,0.0,,""m""", @"", @"-- 16A util on the last file in the 31 days to the date, HF scope, out-of-scope envelopes excluded (A3b).
-- Source switch (A4): CORTEX when chosen and CORTEX has a limit for the selection, else facts (as P1 G1).
