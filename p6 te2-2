defs.Add(new[] { @"P6 M 06 Status", @"P6\3 Movers", @"", @"", @"-- 06 at the last 06 file: R breach (Comment ""dépassement""), F frozen (""Autorisation gelée""), Y util ≥ 90 %, G otherwise.
