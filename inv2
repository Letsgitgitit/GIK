
DEFINE
    VAR _p6Last16 = CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS() )
    VAR _p6Last06 = CALCULATE( MAX( FACT_LIMIT_06[SnapshotDate] ), REMOVEFILTERS() )
    VAR _p6LastRp = CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ), REMOVEFILTERS() )
    VAR _p6HfIds =
        CALCULATETABLE(
            VALUES( FACT_LIMIT_16A[HeadOfficeSirisId] ),
            REMOVEFILTERS(),
            FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
            FACT_LIMIT_16A[Sector] = "Hedge Fund"
        )

// ---- Q1 schema ---------------------------------------------------------------------------
EVALUATE
    FILTER(
        INFO.VIEW.COLUMNS(),
        [Table] IN { "FACT_LIMIT_16A", "FACT_LIMIT_06", "FACT_ALLREPO", "DIM_COUNTERPARTY", "DIM_MCG" }
    )
    ORDER BY [Table], [Name]

// ---- Q2 HF scope at the last 16A date   [may error: DIM_COUNTERPARTY[MCG_Code]] -------------
//      Which definition of "hedge fund" to use: 16A Sector = "Hedge Fund", MCG41, or both. Util = per-auth MAX.
EVALUATE
    VAR base =
        FILTER(
            CALCULATETABLE(
                SUMMARIZE( FACT_LIMIT_16A, FACT_LIMIT_16A[Sector], DIM_COUNTERPARTY[MCG_Code] ),
                REMOVEFILTERS(),
                FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
                FACT_LIMIT_16A[StructureType] <> "No authorisation"
            ),
            CONTAINSSTRING( FACT_LIMIT_16A[Sector], "Fund" ) || DIM_COUNTERPARTY[MCG_Code] IN { "MCG41", "MCG44" }
        )
    RETURN
        ADDCOLUMNS(
            base,
            "CPYs", CALCULATE( DISTINCTCOUNT( FACT_LIMIT_16A[HeadOfficeSirisId] ), FACT_LIMIT_16A[SnapshotDate] = _p6Last16 ),
            "CPHs", CALCULATE( DISTINCTCOUNT( DIM_COUNTERPARTY[CPH_Id] ), FACT_LIMIT_16A[SnapshotDate] = _p6Last16 ),
            "Util16A_EUR",
                CALCULATE(
                    SUMX( VALUES( FACT_LIMIT_16A[AuthorisationId] ), CALCULATE( MAX( FACT_LIMIT_16A[Utilisation] ) ) ),
                    FACT_LIMIT_16A[SnapshotDate] = _p6Last16, FACT_LIMIT_16A[StructureType] <> "No authorisation" ),
            "Auth16A_EUR",
                CALCULATE(
                    SUMX( VALUES( FACT_LIMIT_16A[AuthorisationId] ), CALCULATE( MAX( FACT_LIMIT_16A[Amount] ) ) ),
                    FACT_LIMIT_16A[SnapshotDate] = _p6Last16, FACT_LIMIT_16A[StructureType] <> "No authorisation" )
        )
    ORDER BY [Util16A_EUR] DESC

// ---- Q3 tenor-band labels on HF rows, last date ---------------------------------------------
//      Band k: label, rows, auths, MAX band util summed per auth. Labels decide the fixed buckets on C.
EVALUATE
    VAR hfRows =
        CALCULATETABLE( FACT_LIMIT_16A, REMOVEFILTERS(), FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
            TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ), FACT_LIMIT_16A[StructureType] <> "No authorisation" )
    VAR b1 = SELECTCOLUMNS( hfRows, "Band", 1, "Label", FACT_LIMIT_16A[Timebucket1], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB1] )
    VAR b2 = SELECTCOLUMNS( hfRows, "Band", 2, "Label", FACT_LIMIT_16A[Timebucket2], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB2] )
    VAR b3 = SELECTCOLUMNS( hfRows, "Band", 3, "Label", FACT_LIMIT_16A[Timebucket3], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB3] )
    VAR b4 = SELECTCOLUMNS( hfRows, "Band", 4, "Label", FACT_LIMIT_16A[Timebucket4], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB4] )
    VAR b5 = SELECTCOLUMNS( hfRows, "Band", 5, "Label", FACT_LIMIT_16A[Timebucket5], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB5] )
    VAR b6 = SELECTCOLUMNS( hfRows, "Band", 6, "Label", FACT_LIMIT_16A[Timebucket6], "Auth", FACT_LIMIT_16A[AuthorisationId], "Util", FACT_LIMIT_16A[UtilisationTB6] )
    VAR allB = UNION( b1, b2, b3, b4, b5, b6 )
    RETURN
        GROUPBY(
            allB, [Band], [Label],
            "Rows", COUNTX( CURRENTGROUP(), 1 ),
            "MaxUtil", MAXX( CURRENTGROUP(), [Util] ),
            "SumUtilRows", SUMX( CURRENTGROUP(), [Util] )
        )
    ORDER BY [Band], [Rows] DESC

// ---- Q4 tenor-band nesting checks, HF, last date ---------------------------------------------
EVALUATE
    VAR hfRows =
        CALCULATETABLE( FACT_LIMIT_16A, REMOVEFILTERS(), FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
            TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ), FACT_LIMIT_16A[StructureType] <> "No authorisation" )
    RETURN
        ROW(
            "HfRows", COUNTROWS( hfRows ),
            "HfAuths", COUNTROWS( SUMMARIZE( hfRows, FACT_LIMIT_16A[AuthorisationId] ) ),
            "RowsAllBandsZeroOrBlank",
                COUNTROWS( FILTER( hfRows,
                    COALESCE( FACT_LIMIT_16A[UtilisationTB1], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB2], 0 )
                    + COALESCE( FACT_LIMIT_16A[UtilisationTB3], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB4], 0 )
                    + COALESCE( FACT_LIMIT_16A[UtilisationTB5], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB6], 0 ) = 0 ) ),
            "RowsAllBandsZero_UtilPositive",
                COUNTROWS( FILTER( hfRows, FACT_LIMIT_16A[Utilisation] > 0 &&
                    COALESCE( FACT_LIMIT_16A[UtilisationTB1], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB2], 0 )
                    + COALESCE( FACT_LIMIT_16A[UtilisationTB3], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB4], 0 )
                    + COALESCE( FACT_LIMIT_16A[UtilisationTB5], 0 ) + COALESCE( FACT_LIMIT_16A[UtilisationTB6], 0 ) = 0 ) ),
            "RowsBandAboveTotal",
                COUNTROWS( FILTER( hfRows,
                    MAX( MAX( MAX( COALESCE( FACT_LIMIT_16A[UtilisationTB1], 0 ), COALESCE( FACT_LIMIT_16A[UtilisationTB2], 0 ) ),
                              MAX( COALESCE( FACT_LIMIT_16A[UtilisationTB3], 0 ), COALESCE( FACT_LIMIT_16A[UtilisationTB4], 0 ) ) ),
                         MAX( COALESCE( FACT_LIMIT_16A[UtilisationTB5], 0 ), COALESCE( FACT_LIMIT_16A[UtilisationTB6], 0 ) ) )
                    > FACT_LIMIT_16A[Utilisation] * 1.001 ) ),
            "RowsBandUtilButNoLabel",
                COUNTROWS( FILTER( hfRows,
                    ( COALESCE( FACT_LIMIT_16A[UtilisationTB1], 0 ) > 0 && LEN( FACT_LIMIT_16A[Timebucket1] ) = 0 )
                    || ( COALESCE( FACT_LIMIT_16A[UtilisationTB2], 0 ) > 0 && LEN( FACT_LIMIT_16A[Timebucket2] ) = 0 )
                    || ( COALESCE( FACT_LIMIT_16A[UtilisationTB3], 0 ) > 0 && LEN( FACT_LIMIT_16A[Timebucket3] ) = 0 ) ) ),
            "RowsTB1DecreasingTB2",
                COUNTROWS( FILTER( hfRows, COALESCE( FACT_LIMIT_16A[UtilisationTB2], 0 ) > COALESCE( FACT_LIMIT_16A[UtilisationTB1], 0 ) ) )
        )

// ---- Q5 removed (BUILD b): MtM_BO_EUR is not in the model. MtM goes to the HF side table (parked).

// ---- Q6 HF 16A by CPH, last date, top 25 ----------------------------------------------------
EVALUATE
    TOPN(
        25,
        ADDCOLUMNS(
            CALCULATETABLE( SUMMARIZE( FACT_LIMIT_16A, DIM_COUNTERPARTY[CPH_Id], DIM_COUNTERPARTY[CPH_Name] ), REMOVEFILTERS(),
                FACT_LIMIT_16A[SnapshotDate] = _p6Last16, TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ) ),
            "CPYs", CALCULATE( DISTINCTCOUNT( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS( FACT_LIMIT_16A ),
                FACT_LIMIT_16A[SnapshotDate] = _p6Last16, TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ) ),
            "Util16A_EUR",
                CALCULATE(
                    SUMX( VALUES( FACT_LIMIT_16A[AuthorisationId] ), CALCULATE( MAX( FACT_LIMIT_16A[Utilisation] ) ) ),
                    REMOVEFILTERS( FACT_LIMIT_16A ), FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
                    TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ), FACT_LIMIT_16A[StructureType] <> "No authorisation" ),
            "Auth16A_EUR",
                CALCULATE(
                    SUMX( VALUES( FACT_LIMIT_16A[AuthorisationId] ), CALCULATE( MAX( FACT_LIMIT_16A[Amount] ) ) ),
                    REMOVEFILTERS( FACT_LIMIT_16A ), FACT_LIMIT_16A[SnapshotDate] = _p6Last16,
                    TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ), FACT_LIMIT_16A[StructureType] <> "No authorisation" ),
            "Structures", CALCULATE( CONCATENATEX( VALUES( FACT_LIMIT_16A[StructureType] ), FACT_LIMIT_16A[StructureType], "/" ),
                REMOVEFILTERS( FACT_LIMIT_16A ), FACT_LIMIT_16A[SnapshotDate] = _p6Last16, TREATAS( _p6HfIds, FACT_LIMIT_16A[HeadOfficeSirisId] ) )
        ),
        [Util16A_EUR], DESC
    )
    ORDER BY [Util16A_EUR] DESC

// ---- Q7 ALLREPO HF, last date ----------------------------------------------------------------
EVALUATE
    ADDCOLUMNS(
        CALCULATETABLE( VALUES( FACT_ALLREPO[BuySell] ), REMOVEFILTERS(), FACT_ALLREPO[SnapshotDate] = _p6LastRp,
            TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "LastRepoDate", _p6LastRp,
        "Rows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "CPYs", CALCULATE( DISTINCTCOUNT( FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "CashAmount_EUR", CALCULATE( SUM( FACT_ALLREPO[CashAmount_EUR] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "NotionalBond_EUR", CALCULATE( SUM( FACT_ALLREPO[NotionalBond_EUR] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "RiskBrut_EUR", CALCULATE( SUM( FACT_ALLREPO[RiskBrut_EUR] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "RiskNet_EUR", CALCULATE( SUM( FACT_ALLREPO[RiskNet_EUR] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "HaircutEq1Rows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[Haircut] = 1 ),
        "HaircutBlankRows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ), ISBLANK( FACT_ALLREPO[Haircut] ) ),
        "HaircutMin", CALCULATE( MIN( FACT_ALLREPO[Haircut] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "HaircutMax_excl1", CALCULATE( MAX( FACT_ALLREPO[Haircut] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[Haircut] < 1 ),
        "WtdHaircut_excl1",
            DIVIDE(
                CALCULATE( SUMX( FACT_ALLREPO, FACT_ALLREPO[Haircut] * ABS( FACT_ALLREPO[NotionalBond_EUR] ) ),
                    FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[Haircut] < 1 ),
                CALCULATE( SUMX( FACT_ALLREPO, ABS( FACT_ALLREPO[NotionalBond_EUR] ) ),
                    FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[Haircut] < 1 ) ),
        "IssuerUnknownRows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ),
            CONTAINSSTRING( FACT_ALLREPO[IssuerId], "#" ) ),
        "Issuers", CALCULATE( DISTINCTCOUNT( FACT_ALLREPO[IssuerId] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) )
    )

// ---- Q8 HF reverse repo by month since 2023 (cost test, R "over time") ------------------------
//      Month-end snapshot per month. If > 60 s: the R history view needs a small monthly gold aggregate.
EVALUATE
    VAR monthEnds =
        CALCULATETABLE(
            ADDCOLUMNS( VALUES( DIM_DATE[YearMonth] ), "@ME", CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ) ) ),
            REMOVEFILTERS(), DIM_DATE[Date] >= DATE( 2023, 1, 1 ), DIM_DATE[Date] <= _p6LastRp
        )
    RETURN
        ADDCOLUMNS(
            FILTER( monthEnds, NOT ISBLANK( [@ME] ) ),
            "Collateral_EUR",
                VAR d = [@ME]
                RETURN CALCULATE( SUM( FACT_ALLREPO[NotionalBond_EUR] ), REMOVEFILTERS(), FACT_ALLREPO[SnapshotDate] = d,
                    FACT_ALLREPO[BuySell] = "B", TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
            "WtdHaircut",
                VAR d = [@ME]
                RETURN DIVIDE(
                    CALCULATE( SUMX( FACT_ALLREPO, FACT_ALLREPO[Haircut] * ABS( FACT_ALLREPO[NotionalBond_EUR] ) ), REMOVEFILTERS(),
                        FACT_ALLREPO[SnapshotDate] = d, FACT_ALLREPO[BuySell] = "B", FACT_ALLREPO[Haircut] < 1,
                        TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
                    CALCULATE( SUMX( FACT_ALLREPO, ABS( FACT_ALLREPO[NotionalBond_EUR] ) ), REMOVEFILTERS(),
                        FACT_ALLREPO[SnapshotDate] = d, FACT_ALLREPO[BuySell] = "B", FACT_ALLREPO[Haircut] < 1,
                        TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ) ),
            "CPYs",
                VAR d = [@ME]
                RETURN CALCULATE( DISTINCTCOUNT( FACT_ALLREPO[HeadOfficeSirisId] ), REMOVEFILTERS(), FACT_ALLREPO[SnapshotDate] = d,
                    FACT_ALLREPO[BuySell] = "B", TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) )
        )
    ORDER BY DIM_DATE[YearMonth]

// ---- Q9 Rating_ssj values on HF reverse repo collateral, last date ---------------------------
EVALUATE
    ADDCOLUMNS(
        CALCULATETABLE( VALUES( FACT_ALLREPO[Rating_ssj] ), REMOVEFILTERS(), FACT_ALLREPO[SnapshotDate] = _p6LastRp,
            FACT_ALLREPO[BuySell] = "B", TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "Rows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, FACT_ALLREPO[BuySell] = "B",
            TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
        "Collateral_EUR", CALCULATE( SUM( FACT_ALLREPO[NotionalBond_EUR] ), FACT_ALLREPO[SnapshotDate] = _p6LastRp, FACT_ALLREPO[BuySell] = "B",
            TREATAS( _p6HfIds, FACT_ALLREPO[HeadOfficeSirisId] ) )
    )
    ORDER BY [Collateral_EUR] DESC

// ---- Q10 06 HF, last date -----------------------------------------------------------------------
EVALUATE
    ADDCOLUMNS(
        CALCULATETABLE( SUMMARIZE( FACT_LIMIT_06, FACT_LIMIT_06[StructureType], FACT_LIMIT_06[Comment] ), REMOVEFILTERS(),
            FACT_LIMIT_06[SnapshotDate] = _p6Last06, TREATAS( _p6HfIds, FACT_LIMIT_06[HeadOfficeSirisId] ) ),
        "Last06Date", _p6Last06,
        "Rows", CALCULATE( COUNTROWS( FACT_LIMIT_06 ), FACT_LIMIT_06[SnapshotDate] = _p6Last06, TREATAS( _p6HfIds, FACT_LIMIT_06[HeadOfficeSirisId] ) ),
        "CPYs", CALCULATE( DISTINCTCOUNT( FACT_LIMIT_06[HeadOfficeSirisId] ), FACT_LIMIT_06[SnapshotDate] = _p6Last06, TREATAS( _p6HfIds, FACT_LIMIT_06[HeadOfficeSirisId] ) ),
        "Util06_EUR",
            CALCULATE( SUMX( VALUES( FACT_LIMIT_06[AuthorisationId] ), CALCULATE( MAX( FACT_LIMIT_06[Utilisation] ) ) ),
                FACT_LIMIT_06[SnapshotDate] = _p6Last06, TREATAS( _p6HfIds, FACT_LIMIT_06[HeadOfficeSirisId] ) ),
        "AvailableNegRows", CALCULATE( COUNTROWS( FACT_LIMIT_06 ), FACT_LIMIT_06[SnapshotDate] = _p6Last06,
            TREATAS( _p6HfIds, FACT_LIMIT_06[HeadOfficeSirisId] ), FACT_LIMIT_06[Available] < 0 )
    )
    ORDER BY [Rows] DESC

DEFINE
    VAR _cLast16 = CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS() )
    VAR _cLastRp = CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ), REMOVEFILTERS() )
    VAR _cHfIds =
        CALCULATETABLE( VALUES( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS(),
            FACT_LIMIT_16A[SnapshotDate] = _cLast16, FACT_LIMIT_16A[Sector] = "Hedge Fund" )

// ---- C1 ALLREPO direction ------------------------------------------------------------------
EVALUATE
    SUMMARIZECOLUMNS(
        FACT_ALLREPO[BuySell],
        FACT_ALLREPO[InstLabel],
        FACT_ALLREPO[ProductType],
        FACT_ALLREPO[SLA_CateCode],
        TREATAS( { _cLastRp }, FACT_ALLREPO[SnapshotDate] ),
        TREATAS( _cHfIds, FACT_ALLREPO[HeadOfficeSirisId] ),
        "Rows", COUNTROWS( FACT_ALLREPO ),
        "Trades", DISTINCTCOUNT( FACT_ALLREPO[TransactionId] ),
        "CPYs", DISTINCTCOUNT( FACT_ALLREPO[HeadOfficeSirisId] ),
        "CashAmount_EUR", SUM( FACT_ALLREPO[CashAmount_EUR] ),
        "NotionalBond_EUR", SUM( FACT_ALLREPO[NotionalBond_EUR] ),
        "RiskNet_EUR", SUM( FACT_ALLREPO[RiskNet_EUR] ),
        "HaircutNonZeroRows", CALCULATE( COUNTROWS( FACT_ALLREPO ), FACT_ALLREPO[Haircut] <> 0 ),
        "MaxCashOneTrade_EUR", MAX( FACT_ALLREPO[CashAmount_EUR] )
    )
    ORDER BY FACT_ALLREPO[BuySell], [CashAmount_EUR] DESC

// ---- C2 maturity profile of live HF deals (FACT_SALES) ---------------------------------------
EVALUATE
    VAR live =
        CALCULATETABLE(
            FACT_SALES,
            REMOVEFILTERS(),
            TREATAS( _cHfIds, FACT_SALES[RicosCode] ),
            FACT_SALES[MaturityDate] > _cLast16,
            FACT_SALES[MaturityDate] < DATE( 2099, 1, 1 ),
            FACT_SALES[IsRebooked] = FALSE ()
        )
    VAR tagged =
        ADDCOLUMNS(
            live,
            "@Bucket",
                VAR yrs = ( FACT_SALES[MaturityDate] - _cLast16 ) / 365.25
                RETURN SWITCH( TRUE (), yrs <= 1, "1 0-1Y", yrs <= 3, "2 1-3Y", yrs <= 5, "3 3-5Y", yrs <= 10, "4 5-10Y", "5 10Y+" )
        )
    RETURN
        GROUPBY(
            tagged,
            FACT_SALES[ProductLineGroupName],
            [@Bucket],
            "Deals", COUNTX( CURRENTGROUP(), 1 ),
            "Notional_EUR", SUMX( CURRENTGROUP(), ABS( FACT_SALES[NominalAmountEUR] ) ),
            "OldestDeal", MINX( CURRENTGROUP(), FACT_SALES[DealDate] )
        )
    ORDER BY FACT_SALES[ProductLineGroupName], [@Bucket]













DEFINE
    VAR _rLast16 = CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS() )
    VAR _rLastRc = CALCULATE( MAX( FACT_RECONC[SnapshotDate] ), REMOVEFILTERS() )
    VAR _rLastRp = CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ), REMOVEFILTERS() )
    VAR _rHfIds =
        CALCULATETABLE( VALUES( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS(),
            FACT_LIMIT_16A[SnapshotDate] = _rLast16, FACT_LIMIT_16A[Sector] = "Hedge Fund" )

// ---- R1 RECONC 17A / 17B, HF, total lines -------------------------------------------------------
EVALUATE
    SUMMARIZECOLUMNS(
        FACT_RECONC[Category],
        FACT_RECONC[SGC_UnitCode],
        TREATAS( { _rLastRc }, FACT_RECONC[SnapshotDate] ),
        TREATAS( _rHfIds, FACT_RECONC[HeadOfficeSirisId] ),
        FILTER( ALL( FACT_RECONC[IsEnvelopeTotal] ), FACT_RECONC[IsEnvelopeTotal] = TRUE () ),
        "LastReconcDate", _rLastRc,
        "Auths", DISTINCTCOUNT( FACT_RECONC[AuthorisationId] ),
        "CPYs", DISTINCTCOUNT( FACT_RECONC[HeadOfficeSirisId] ),
        "AuthoEUR", SUM( FACT_RECONC[AuthoEUR] ),
        "UtilEUR", SUM( FACT_RECONC[UtilEUR] )
    )
    ORDER BY FACT_RECONC[Category], FACT_RECONC[SGC_UnitCode]

// ---- R2 ALLREPO repo-type rows, HF, last date ------------------------------------------------------
EVALUATE
    SUMMARIZECOLUMNS(
        FACT_ALLREPO[BuySell],
        FACT_ALLREPO[InstLabel],
        FACT_ALLREPO[CDR_BOPCCode],
        TREATAS( { _rLastRp }, FACT_ALLREPO[SnapshotDate] ),
        TREATAS( _rHfIds, FACT_ALLREPO[HeadOfficeSirisId] ),
        TREATAS( { "07L" }, FACT_ALLREPO[SLA_CateCode] ),
        "Trades", COUNTROWS( FACT_ALLREPO ),
        "CPYs", DISTINCTCOUNT( FACT_ALLREPO[HeadOfficeSirisId] ),
        "CashAmount_EUR", SUM( FACT_ALLREPO[CashAmount_EUR] ),
        "NotionalBond_EUR", SUM( FACT_ALLREPO[NotionalBond_EUR] )
    )
    ORDER BY FACT_ALLREPO[BuySell], [CashAmount_EUR] DESC




DEFINE
    VAR _qLast16 = CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), REMOVEFILTERS() )
    VAR _qLastRc = CALCULATE( MAX( FACT_RECONC[SnapshotDate] ), REMOVEFILTERS() )
    VAR _qLastRp = CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ), REMOVEFILTERS() )
    VAR _qHfIds =
        CALCULATETABLE( VALUES( FACT_LIMIT_16A[HeadOfficeSirisId] ), REMOVEFILTERS(),
            FACT_LIMIT_16A[SnapshotDate] = _qLast16, FACT_LIMIT_16A[Sector] = "Hedge Fund" )
    VAR _qRc =
        CALCULATETABLE(
            FACT_RECONC, REMOVEFILTERS(),
            FACT_RECONC[SnapshotDate] = _qLastRc, FACT_RECONC[IsEnvelopeTotal] = TRUE (),
            TREATAS( _qHfIds, FACT_RECONC[HeadOfficeSirisId] ) )
    VAR _qRp =
        FILTER(
            CALCULATETABLE(
                FACT_ALLREPO, REMOVEFILTERS(),
                FACT_ALLREPO[SnapshotDate] = _qLastRp, FACT_ALLREPO[SLA_CateCode] = "07L",
                TREATAS( _qHfIds, FACT_ALLREPO[HeadOfficeSirisId] ) ),
            NOT CONTAINSSTRING( FACT_ALLREPO[InstLabel], "Sponsored" ) )
    VAR _qIds =
        DISTINCT(
            UNION(
                SELECTCOLUMNS( _qRc, "Id", FACT_RECONC[HeadOfficeSirisId] ),
                SELECTCOLUMNS( _qRp, "Id", FACT_ALLREPO[HeadOfficeSirisId] ) ) )
    VAR _qRows =
        ADDCOLUMNS(
            _qIds,
            "Name", LOOKUPVALUE( DIM_COUNTERPARTY[Name], DIM_COUNTERPARTY[HeadOfficeSirisId], [Id] ),
            "Util17A", VAR i = [Id] RETURN SUMX( FILTER( _qRc, FACT_RECONC[HeadOfficeSirisId] = i && FACT_RECONC[Category] = "17A" ), FACT_RECONC[UtilEUR] ),
            "Util17B", VAR i = [Id] RETURN SUMX( FILTER( _qRc, FACT_RECONC[HeadOfficeSirisId] = i && FACT_RECONC[Category] = "17B" ), FACT_RECONC[UtilEUR] ),
            "Util17A_BC10", VAR i = [Id] RETURN SUMX( FILTER( _qRc, FACT_RECONC[HeadOfficeSirisId] = i && FACT_RECONC[Category] = "17A" && FACT_RECONC[SGC_UnitCode] = "10" ), FACT_RECONC[UtilEUR] ),
            "Util17B_BC10", VAR i = [Id] RETURN SUMX( FILTER( _qRc, FACT_RECONC[HeadOfficeSirisId] = i && FACT_RECONC[Category] = "17B" && FACT_RECONC[SGC_UnitCode] = "10" ), FACT_RECONC[UtilEUR] ),
            "Cash_S", VAR i = [Id] RETURN SUMX( FILTER( _qRp, FACT_ALLREPO[HeadOfficeSirisId] = i && FACT_ALLREPO[BuySell] = "S" ), FACT_ALLREPO[CashAmount_EUR] ),
            "Cash_B", VAR i = [Id] RETURN SUMX( FILTER( _qRp, FACT_ALLREPO[HeadOfficeSirisId] = i && FACT_ALLREPO[BuySell] = "B" ), FACT_ALLREPO[CashAmount_EUR] ),
            "Face_S", VAR i = [Id] RETURN SUMX( FILTER( _qRp, FACT_ALLREPO[HeadOfficeSirisId] = i && FACT_ALLREPO[BuySell] = "S" ), FACT_ALLREPO[NotionalBond_EUR] ),
            "Face_B", VAR i = [Id] RETURN SUMX( FILTER( _qRp, FACT_ALLREPO[HeadOfficeSirisId] = i && FACT_ALLREPO[BuySell] = "B" ), FACT_ALLREPO[NotionalBond_EUR] )
        )

// ---- Q1 per CPY ---------------------------------------------------------------------------------
EVALUATE
    ADDCOLUMNS(
        _qRows,
        "Verdict",
            VAR a = COALESCE( [Util17A], 0 )
            VAR b = COALESCE( [Util17B], 0 )
            VAR s = COALESCE( [Cash_S], 0 )
            VAR bb = COALESCE( [Cash_B], 0 )
            VAR errRule = ABS( a - s ) + ABS( b - bb )        // S = 17A, B = 17B
            VAR errFlip = ABS( a - bb ) + ABS( b - s )        // S = 17B, B = 17A
            RETURN
                SWITCH( TRUE (),
                    a + b + s + bb = 0, "nothing",
                    errRule < errFlip * 0.5, "S=17A, B=17B",
                    errFlip < errRule * 0.5, "S=17B, B=17A",
                    "unclear" )
    )
    ORDER BY [Util17B] DESC, [Util17A] DESC

// ---- Q2 count of CPYs per verdict, and the utilisation they carry -------------------------------------
EVALUATE
    GROUPBY(
        ADDCOLUMNS(
            _qRows,
            "@V",
                VAR a = COALESCE( [Util17A], 0 ) VAR b = COALESCE( [Util17B], 0 )
                VAR s = COALESCE( [Cash_S], 0 ) VAR bb = COALESCE( [Cash_B], 0 )
                VAR errRule = ABS( a - s ) + ABS( b - bb ) VAR errFlip = ABS( a - bb ) + ABS( b - s )
                RETURN SWITCH( TRUE (), a + b + s + bb = 0, "nothing", errRule < errFlip * 0.5, "S=17A, B=17B",
                    errFlip < errRule * 0.5, "S=17B, B=17A", "unclear" ),
            "@U", COALESCE( [Util17A], 0 ) + COALESCE( [Util17B], 0 )
        ),
        [@V],
        "CPYs", COUNTX( CURRENTGROUP(), 1 ),
        "Util17A17B", SUMX( CURRENTGROUP(), [@U] )
    )
