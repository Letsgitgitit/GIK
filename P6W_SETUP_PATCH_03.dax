// =====================================================================================
// P6B_16A_BRIDGE_CHECK_3.dax  -  BUILD 2026-11-12a  -  read-only, DAX query view
// Same fund, now split by collateral agreement (CCCCollatContractId) and netting set (CCCNettingContractId), to test
// whether the market-risk figures (one GMRA: MtM -119 -> -65, repo 4.9bn, rev. repo 10.4 -> 10.6bn) are reproduced
// at agreement level. Needs the four CCC columns in FACT_ALLREPO (add them to the ALLREPO query if they are not there:
// CCCNettingFlag, CCCNettingContractId, CCCCollatFlag, CCCCollatContractId — low cardinality, cheap).
// SET _ids as before. €m / €bn. Sponsored excluded, 07L.
// =====================================================================================
DEFINE
    VAR _ids = { "0000000000" }                 // <- the fund's Ricos
    VAR _notSp = FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], "Sponsored" ) )

// ---- G1 per file × collateral agreement × netting set: notional per side, repo MtM (B - S, negative = in our favour),
//      net / gross risk. The agreement the risk note names should show MtM ≈ -119 (4 Nov) and ≈ -65 (11 Nov) -----------
EVALUATE
    CALCULATETABLE (
        SUMMARIZECOLUMNS ( FACT_ALLREPO[SnapshotDate], FACT_ALLREPO[CCCCollatContractId], FACT_ALLREPO[CCCNettingContractId],
            FACT_ALLREPO[CCCCollatFlag], FACT_ALLREPO[CCCNettingFlag],
            "Trades", DISTINCTCOUNT ( FACT_ALLREPO[CCCTradeKey] ),
            "Repo_bn", CALCULATE ( SUM ( FACT_ALLREPO[CashAmount_EUR] ), FACT_ALLREPO[BuySell] = "B" ) / 1E9,
            "RevRepo_bn", CALCULATE ( SUM ( FACT_ALLREPO[CashAmount_EUR] ), FACT_ALLREPO[BuySell] = "S" ) / 1E9,
            "RepoMtM_m", ( CALCULATE ( SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) - SUM ( FACT_ALLREPO[MTMCash_EUR] ), FACT_ALLREPO[BuySell] = "B" )
                - CALCULATE ( SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) - SUM ( FACT_ALLREPO[MTMCash_EUR] ), FACT_ALLREPO[BuySell] = "S" ) ) / 1E6,
            "RiskNet_m", SUM ( FACT_ALLREPO[RiskNet_EUR] ) / 1E6,
            "RiskGross_m", SUM ( FACT_ALLREPO[RiskBrut_EUR] ) / 1E6 ),
        REMOVEFILTERS (), TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ),
        FACT_ALLREPO[SnapshotDate] IN { DATE ( 2026, 11, 4 ), DATE ( 2026, 11, 6 ), DATE ( 2026, 11, 9 ), DATE ( 2026, 11, 11 ) },
        FACT_ALLREPO[SLA_CateCode] = "07L", _notSp )
    ORDER BY FACT_ALLREPO[CCCCollatContractId], FACT_ALLREPO[SnapshotDate]

// ---- G2 does the agreement span other entities? (other Ricos booked under the same collateral agreements) -------------
EVALUATE
    VAR _agr = CALCULATETABLE ( VALUES ( FACT_ALLREPO[CCCCollatContractId] ), REMOVEFILTERS (),
        TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = DATE ( 2026, 11, 11 ) )
    RETURN
        CALCULATETABLE (
            SUMMARIZECOLUMNS ( FACT_ALLREPO[CCCCollatContractId], FACT_ALLREPO[HeadOfficeSirisId],
                "Trades", DISTINCTCOUNT ( FACT_ALLREPO[CCCTradeKey] ),
                "Cash_bn", SUM ( FACT_ALLREPO[CashAmount_EUR] ) / 1E9 ),
            REMOVEFILTERS (), TREATAS ( _agr, FACT_ALLREPO[CCCCollatContractId] ),
            FACT_ALLREPO[SnapshotDate] = DATE ( 2026, 11, 11 ), FACT_ALLREPO[SLA_CateCode] = "07L" )
    ORDER BY FACT_ALLREPO[CCCCollatContractId], [Cash_bn] DESC

// ---- G3 (added after G1) why our notional is above the risk note's (6.7 / 16.0bn vs 4.9 / 10.6bn on 11 Nov) while MtM
//      is close: split by forward-starting (StartDate after the file date), maturing within 1 business day, and the rest.
//      StartDate may not be in the model: if it errors, add it to the ALLREPO query (or comment G3 out).
EVALUATE
    VAR _d = DATE ( 2026, 11, 11 )
    RETURN
        ADDCOLUMNS (
            DATATABLE ( "Bucket", STRING, { { "forward-starting" }, { "matures <= next day" }, { "live, other" } } ),
            "Repo_bn", VAR b = [Bucket] RETURN CALCULATE ( SUM ( FACT_ALLREPO[CashAmount_EUR] ), REMOVEFILTERS (),
                TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = _d, FACT_ALLREPO[SLA_CateCode] = "07L",
                FACT_ALLREPO[BuySell] = "B", _notSp,
                FILTER ( ALL ( FACT_ALLREPO[StartDate], FACT_ALLREPO[MaturityDate] ),
                    SWITCH ( b, "forward-starting", FACT_ALLREPO[StartDate] > _d,
                        "matures <= next day", FACT_ALLREPO[StartDate] <= _d && FACT_ALLREPO[MaturityDate] <= _d + 3,
                        FACT_ALLREPO[StartDate] <= _d && FACT_ALLREPO[MaturityDate] > _d + 3 ) ) ) / 1E9,
            "RevRepo_bn", VAR b = [Bucket] RETURN CALCULATE ( SUM ( FACT_ALLREPO[CashAmount_EUR] ), REMOVEFILTERS (),
                TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = _d, FACT_ALLREPO[SLA_CateCode] = "07L",
                FACT_ALLREPO[BuySell] = "S", _notSp,
                FILTER ( ALL ( FACT_ALLREPO[StartDate], FACT_ALLREPO[MaturityDate] ),
                    SWITCH ( b, "forward-starting", FACT_ALLREPO[StartDate] > _d,
                        "matures <= next day", FACT_ALLREPO[StartDate] <= _d && FACT_ALLREPO[MaturityDate] <= _d + 3,
                        FACT_ALLREPO[StartDate] <= _d && FACT_ALLREPO[MaturityDate] > _d + 3 ) ) ) / 1E9 )
