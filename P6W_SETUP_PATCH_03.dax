// =====================================================================================
// P6B_16A_BRIDGE_CHECK_2.dax  -  BUILD 2026-11-12c  -  read-only, DAX query view
// Second pass on the 16A spike (one fund, 6 -> 11 Nov 2026), now with the ALLREPO MtM columns back.
// Splits the reverse-repo (S) net-risk jump into: trades kept (MtM moved / haircut moved), trades new, trades gone;
// shows netting (gross - net risk) and the issuer groups behind it.
// SET: _ids (same Ricos as check 1) ; _p0 / _p1 = the two ALLREPO files to compare (rerun with 6->9 and 9->11 Nov too).
// If the MtM columns sit in a separate test query and not in FACT_ALLREPO, Ctrl+H: FACT_ALLREPO -> that query's name.
// 12c: no MarkToMark_EUR in ALLREPO. "MtM" = MTMSecurity_EUR - MTMCash_EUR (bond leg minus cash leg); C1 shows both legs
// so the sign can be checked against 16A MtM_BO_EUR.
// Columns used: MTMSecurity_EUR, MTMCash_EUR, RiskNet_EUR, RiskBrut_EUR, NotionalBond_EUR, HaircutValue,
// CCCTradeKey, BuySell, IssuerId, SnapshotDate, SLA_CateCode, InstLabel, HeadOfficeSirisId.
// C1 per file and side ; C2 bridge kept / new / gone (S and B) ; C3 the 15 kept trades whose net risk moved most ;
// C4 S side by issuer group at _p0 and _p1.
// =====================================================================================
DEFINE
    VAR _ids = { "0000000000" }                 // <- the fund's Ricos (as in check 1)
    VAR _p0 = DATE ( 2026, 11, 6 )
    VAR _p1 = DATE ( 2026, 11, 11 )
    VAR _w0 = DATE ( 2026, 10, 20 )
    VAR _w1 = DATE ( 2026, 11, 12 )
    VAR _notSp = FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], "Sponsored" ) )
    // one row per trade and side at a file date: MtM, net / gross risk, face, face x haircut
    VAR _t0 =
        CALCULATETABLE (
            ADDCOLUMNS ( SUMMARIZE ( FACT_ALLREPO, FACT_ALLREPO[CCCTradeKey], FACT_ALLREPO[BuySell], FACT_ALLREPO[IssuerId] ),
                "@m", CALCULATE ( SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) - SUM ( FACT_ALLREPO[MTMCash_EUR] ) ),
                "@rn", CALCULATE ( SUM ( FACT_ALLREPO[RiskNet_EUR] ) ),
                "@rb", CALCULATE ( SUM ( FACT_ALLREPO[RiskBrut_EUR] ) ),
                "@f", CALCULATE ( SUM ( FACT_ALLREPO[NotionalBond_EUR] ) ),
                "@hf", CALCULATE ( SUMX ( FACT_ALLREPO, FACT_ALLREPO[NotionalBond_EUR] * FACT_ALLREPO[HaircutValue] ) ) ),
            REMOVEFILTERS (), TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = _p0,
            FACT_ALLREPO[SLA_CateCode] = "07L", _notSp )
    VAR _t1 =
        CALCULATETABLE (
            ADDCOLUMNS ( SUMMARIZE ( FACT_ALLREPO, FACT_ALLREPO[CCCTradeKey], FACT_ALLREPO[BuySell], FACT_ALLREPO[IssuerId] ),
                "@m", CALCULATE ( SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) - SUM ( FACT_ALLREPO[MTMCash_EUR] ) ),
                "@rn", CALCULATE ( SUM ( FACT_ALLREPO[RiskNet_EUR] ) ),
                "@rb", CALCULATE ( SUM ( FACT_ALLREPO[RiskBrut_EUR] ) ),
                "@f", CALCULATE ( SUM ( FACT_ALLREPO[NotionalBond_EUR] ) ),
                "@hf", CALCULATE ( SUMX ( FACT_ALLREPO, FACT_ALLREPO[NotionalBond_EUR] * FACT_ALLREPO[HaircutValue] ) ) ),
            REMOVEFILTERS (), TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ), FACT_ALLREPO[SnapshotDate] = _p1,
            FACT_ALLREPO[SLA_CateCode] = "07L", _notSp )
    VAR _k0 = SELECTCOLUMNS ( _t0, "k", FACT_ALLREPO[CCCTradeKey] & "|" & FACT_ALLREPO[BuySell] )
    VAR _k1 = SELECTCOLUMNS ( _t1, "k", FACT_ALLREPO[CCCTradeKey] & "|" & FACT_ALLREPO[BuySell] )
    // kept trades with their start values attached
    VAR _kept =
        ADDCOLUMNS (
            FILTER ( _t1, FACT_ALLREPO[CCCTradeKey] & "|" & FACT_ALLREPO[BuySell] IN _k0 ),
            "@m0", VAR k = FACT_ALLREPO[CCCTradeKey] VAR s = FACT_ALLREPO[BuySell]
                   RETURN SUMX ( FILTER ( _t0, FACT_ALLREPO[CCCTradeKey] = k && FACT_ALLREPO[BuySell] = s ), [@m] ),
            "@rn0", VAR k = FACT_ALLREPO[CCCTradeKey] VAR s = FACT_ALLREPO[BuySell]
                   RETURN SUMX ( FILTER ( _t0, FACT_ALLREPO[CCCTradeKey] = k && FACT_ALLREPO[BuySell] = s ), [@rn] ),
            "@rb0", VAR k = FACT_ALLREPO[CCCTradeKey] VAR s = FACT_ALLREPO[BuySell]
                   RETURN SUMX ( FILTER ( _t0, FACT_ALLREPO[CCCTradeKey] = k && FACT_ALLREPO[BuySell] = s ), [@rb] ),
            "@f0", VAR k = FACT_ALLREPO[CCCTradeKey] VAR s = FACT_ALLREPO[BuySell]
                   RETURN SUMX ( FILTER ( _t0, FACT_ALLREPO[CCCTradeKey] = k && FACT_ALLREPO[BuySell] = s ), [@f] ),
            "@hf0", VAR k = FACT_ALLREPO[CCCTradeKey] VAR s = FACT_ALLREPO[BuySell]
                   RETURN SUMX ( FILTER ( _t0, FACT_ALLREPO[CCCTradeKey] = k && FACT_ALLREPO[BuySell] = s ), [@hf] ) )
    VAR _new = FILTER ( _t1, NOT ( FACT_ALLREPO[CCCTradeKey] & "|" & FACT_ALLREPO[BuySell] IN _k0 ) )
    VAR _gone = FILTER ( _t0, NOT ( FACT_ALLREPO[CCCTradeKey] & "|" & FACT_ALLREPO[BuySell] IN _k1 ) )

// ---- C1 per file and side, window 20 Oct -> 12 Nov: MtM (net, bond leg, cash leg), net / gross risk, netting benefit ---
EVALUATE
    CALCULATETABLE (
        SUMMARIZECOLUMNS ( FACT_ALLREPO[SnapshotDate], FACT_ALLREPO[BuySell],
            "Trades", DISTINCTCOUNT ( FACT_ALLREPO[CCCTradeKey] ),
            "Face_bn", SUM ( FACT_ALLREPO[NotionalBond_EUR] ) / 1E9,
            "MtM_m", ( SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) - SUM ( FACT_ALLREPO[MTMCash_EUR] ) ) / 1E6,
            "MtMSec_m", SUM ( FACT_ALLREPO[MTMSecurity_EUR] ) / 1E6,
            "MtMCash_m", SUM ( FACT_ALLREPO[MTMCash_EUR] ) / 1E6,
            "RiskNet_m", SUM ( FACT_ALLREPO[RiskNet_EUR] ) / 1E6,
            "RiskGross_m", SUM ( FACT_ALLREPO[RiskBrut_EUR] ) / 1E6,
            "Netting_m", ( SUM ( FACT_ALLREPO[RiskBrut_EUR] ) - SUM ( FACT_ALLREPO[RiskNet_EUR] ) ) / 1E6,
            "HaircutWtd", DIVIDE ( SUMX ( FACT_ALLREPO, FACT_ALLREPO[NotionalBond_EUR] * FACT_ALLREPO[HaircutValue] ),
                SUM ( FACT_ALLREPO[NotionalBond_EUR] ) ) ),
        REMOVEFILTERS (), TREATAS ( _ids, FACT_ALLREPO[HeadOfficeSirisId] ),
        FACT_ALLREPO[SnapshotDate] >= _w0, FACT_ALLREPO[SnapshotDate] <= _w1, FACT_ALLREPO[SLA_CateCode] = "07L", _notSp )
    ORDER BY FACT_ALLREPO[SnapshotDate], FACT_ALLREPO[BuySell]

// ---- C2 bridge _p0 -> _p1 per side (€m): kept trades (MtM move, net-risk move, haircut before / after), new, gone -----
EVALUATE
    ADDCOLUMNS (
        DATATABLE ( "Side", STRING, { { "B" }, { "S" } } ),
        "Kept_n", VAR s = [Side] RETURN COUNTROWS ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ) ) + 0,
        "Kept_dMtM", VAR s = [Side] RETURN SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@m] - [@m0] ) / 1E6,
        "Kept_dRiskNet", VAR s = [Side] RETURN SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@rn] - [@rn0] ) / 1E6,
        "Kept_dRiskGross", VAR s = [Side] RETURN SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@rb] - [@rb0] ) / 1E6,
        "Kept_dFace_bn", VAR s = [Side] RETURN SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@f] - [@f0] ) / 1E9,
        "Kept_HC0", VAR s = [Side] RETURN DIVIDE ( SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@hf0] ),
            SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@f0] ) ),
        "Kept_HC1", VAR s = [Side] RETURN DIVIDE ( SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@hf] ),
            SUMX ( FILTER ( _kept, FACT_ALLREPO[BuySell] = s ), [@f] ) ),
        "New_n", VAR s = [Side] RETURN COUNTROWS ( FILTER ( _new, FACT_ALLREPO[BuySell] = s ) ) + 0,
        "New_MtM", VAR s = [Side] RETURN SUMX ( FILTER ( _new, FACT_ALLREPO[BuySell] = s ), [@m] ) / 1E6,
        "New_RiskNet", VAR s = [Side] RETURN SUMX ( FILTER ( _new, FACT_ALLREPO[BuySell] = s ), [@rn] ) / 1E6,
        "New_Face_bn", VAR s = [Side] RETURN SUMX ( FILTER ( _new, FACT_ALLREPO[BuySell] = s ), [@f] ) / 1E9,
        "Gone_n", VAR s = [Side] RETURN COUNTROWS ( FILTER ( _gone, FACT_ALLREPO[BuySell] = s ) ) + 0,
        "Gone_MtM", VAR s = [Side] RETURN SUMX ( FILTER ( _gone, FACT_ALLREPO[BuySell] = s ), [@m] ) / 1E6,
        "Gone_RiskNet", VAR s = [Side] RETURN SUMX ( FILTER ( _gone, FACT_ALLREPO[BuySell] = s ), [@rn] ) / 1E6,
        "Gone_Face_bn", VAR s = [Side] RETURN SUMX ( FILTER ( _gone, FACT_ALLREPO[BuySell] = s ), [@f] ) / 1E9 )

// ---- C3 the 15 kept trades whose net risk moved most (€m), with issuer and haircut before / after ---------------------
EVALUATE
    TOPN ( 15,
        SELECTCOLUMNS ( _kept,
            "Trade", FACT_ALLREPO[CCCTradeKey], "Side", FACT_ALLREPO[BuySell],
            "Issuer", LOOKUPVALUE ( 'P6W Issuer Map'[IssuerName], 'P6W Issuer Map'[IssuerId], FACT_ALLREPO[IssuerId] ),
            "Group", LOOKUPVALUE ( 'P6W Issuer Map'[Group], 'P6W Issuer Map'[IssuerId], FACT_ALLREPO[IssuerId] ),
            "Face_m", [@f] / 1E6, "MtM0_m", [@m0] / 1E6, "MtM1_m", [@m] / 1E6,
            "RiskNet0_m", [@rn0] / 1E6, "RiskNet1_m", [@rn] / 1E6, "dRiskNet_m", ( [@rn] - [@rn0] ) / 1E6,
            "HC0", DIVIDE ( [@hf0], [@f0] ), "HC1", DIVIDE ( [@hf], [@f] ) ),
        ABS ( [dRiskNet_m] ), DESC )
    ORDER BY [dRiskNet_m] DESC

// ---- C4 S side by issuer group at _p0 and _p1 (face, MtM, net risk): new underlyings / mix shift -------------------
EVALUATE
    VAR _g0 = ADDCOLUMNS ( FILTER ( _t0, FACT_ALLREPO[BuySell] = "S" ), "@g",
        COALESCE ( LOOKUPVALUE ( 'P6W Issuer Map'[Group], 'P6W Issuer Map'[IssuerId], FACT_ALLREPO[IssuerId] ), "No bond detail" ) )
    VAR _g1 = ADDCOLUMNS ( FILTER ( _t1, FACT_ALLREPO[BuySell] = "S" ), "@g",
        COALESCE ( LOOKUPVALUE ( 'P6W Issuer Map'[Group], 'P6W Issuer Map'[IssuerId], FACT_ALLREPO[IssuerId] ), "No bond detail" ) )
    RETURN
        ADDCOLUMNS ( DISTINCT ( UNION ( SELECTCOLUMNS ( _g0, "Group", [@g] ), SELECTCOLUMNS ( _g1, "Group", [@g] ) ) ),
            "Face0_bn", VAR g = [Group] RETURN SUMX ( FILTER ( _g0, [@g] = g ), [@f] ) / 1E9,
            "Face1_bn", VAR g = [Group] RETURN SUMX ( FILTER ( _g1, [@g] = g ), [@f] ) / 1E9,
            "MtM0_m", VAR g = [Group] RETURN SUMX ( FILTER ( _g0, [@g] = g ), [@m] ) / 1E6,
            "MtM1_m", VAR g = [Group] RETURN SUMX ( FILTER ( _g1, [@g] = g ), [@m] ) / 1E6,
            "RiskNet0_m", VAR g = [Group] RETURN SUMX ( FILTER ( _g0, [@g] = g ), [@rn] ) / 1E6,
            "RiskNet1_m", VAR g = [Group] RETURN SUMX ( FILTER ( _g1, [@g] = g ), [@rn] ) / 1E6,
            "Issuers0", VAR g = [Group] RETURN COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _g0, [@g] = g ), "i", FACT_ALLREPO[IssuerId] ) ) ),
            "Issuers1", VAR g = [Group] RETURN COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _g1, [@g] = g ), "i", FACT_ALLREPO[IssuerId] ) ) ) )
    ORDER BY [RiskNet1_m] DESC
