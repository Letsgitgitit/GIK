==== 2/2  REPLACE
17AB Netting % =
-- Share of gross 17A + 17B utilisation that offsets within each counterparty:
-- per entity 2 x MIN( 17A, 17B ) / ( 17A + 17B ), summed over entities (never across counterparties).
-- RECONC total lines; an authorisation = AuthorisationId + booking centre + category, counted once.
-- Booking centres: those ticked in the P1 Unit slicer (none ticked = all), same rule as the base measures.
-- (Was blank since patch 10: it compared SGC_UnitCode to [Unit Selected], which now returns "SET" / "ALL".)
VAR d = [Snap RECONC]
VAR uSet = VALUES( 'P1 Unit'[Unit Code] )
VAR auths =
    CALCULATETABLE(
        SUMMARIZE( FACT_RECONC, FACT_RECONC[AuthorisationId], FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
        DIM_DATE[Date] = d,
        FACT_RECONC[Category] IN { "17A", "17B" },
        TREATAS( uSet, FACT_RECONC[SGC_UnitCode] ),
        FACT_RECONC[IsNoAuthorisation] = FALSE (),
        NOT ISBLANK( FACT_RECONC[AuthorisationId] )
    )
VAR perAuth =
    CALCULATETABLE(
        ADDCOLUMNS(
            SUMMARIZE( FACT_RECONC, FACT_RECONC[HeadOfficeSirisId], FACT_RECONC[AuthorisationId],
                       FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
            "@u", CALCULATE( MAX( FACT_RECONC[UtilEUR] ) ) ),
        REMOVEFILTERS( DIM_COUNTERPARTY ),
        TREATAS( auths, FACT_RECONC[AuthorisationId], FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
        DIM_DATE[Date] = d,
        FACT_RECONC[IsEnvelopeTotal] = TRUE ()
    )
VAR perCpy =
    GROUPBY( perAuth, FACT_RECONC[HeadOfficeSirisId],
        "@a", SUMX( CURRENTGROUP (), IF( FACT_RECONC[Category] = "17A", [@u] ) ),
        "@b", SUMX( CURRENTGROUP (), IF( FACT_RECONC[Category] = "17B", [@u] ) ) )
VAR grossUtil = SUMX( perCpy, [@a] + [@b] )
VAR offsetUtil = SUMX( perCpy, 2 * MIN( [@a], [@b] ) )
RETURN
    IF( NOT ISBLANK( d ), DIVIDE( offsetUtil, grossUtil ) )

