// =====================================================================================
// P6W_SETUP_PATCH_07.dax  -  BUILD 2026-11-12b  -  tables for the "PX 16A move explainer" drill-through page
// Run BEFORE P6A_MEASURES_TE2.csx build 12e (the script stops if these tables are missing).
// HOW (each block): Modeling ▸ New table ▸ paste the block (name included) ▸ Enter. No relationships to any of them.
// =====================================================================================

// ---- S1 window buttons. Then: Window ▸ Column tools ▸ Sort by column ▸ Order. Hide Days and Order.
PX Window =
DATATABLE (
    "Window", STRING, "Days", INTEGER, "Order", INTEGER,
    { { "1D", 1, 1 }, { "1W", 7, 2 }, { "2W", 14, 3 }, { "1M", 30, 4 }, { "Custom", 0, 5 } }
)

// ---- S2 custom dates ("From" and "To" pickers, used only when Window = Custom). Weekdays since Jan 2025.
PX From =
SELECTCOLUMNS ( FILTER ( CALENDAR ( DATE ( 2025, 1, 1 ), TODAY () ), WEEKDAY ( [Date], 2 ) <= 5 ), "Date", [Date] )

PX To =
SELECTCOLUMNS ( FILTER ( CALENDAR ( DATE ( 2025, 1, 1 ), TODAY () ), WEEKDAY ( [Date], 2 ) <= 5 ), "Date", [Date] )
// For both: select the Date column ▸ Column tools ▸ Format ▸ d mmm yyyy.

// ---- S3 waterfall steps (the X axis of the waterfall). Then: Step ▸ Sort by column ▸ Order. Hide Order.
PX Step =
DATATABLE (
    "Step", STRING, "Order", INTEGER,
    {
        { "16A start", 1 },
        { "Matured trades", 2 },
        { "New trades", 3 },
        { "Revaluation", 4 },
        { "Netting", 5 },
        { "Non-repo", 6 },
        { "16A end", 7 }
    }
)

// ---- S4 (12 Nov b) Sponsored switch (FICC / DTCC repo). Default Exclude = the 6 Nov HF rule. Sort Sponsored by Order.
PX Sponsored =
DATATABLE ( "Sponsored", STRING, "Order", INTEGER, { { "Exclude", 1 }, { "Include", 2 } } )

// ---- S5 (13 Nov) rows of the collateral-check table (PX4). Sort Row by Order; hide Order.
PX Collat Row =
DATATABLE (
    "Row", STRING, "Order", INTEGER,
    {
        { "Repo MtM (− = in our favour)", 1 },
        { "   … matured trades", 2 },
        { "   … trades held", 3 },
        { "   … new trades", 4 },
        { "16A spot exposure", 5 },
        { "Collateral posted (est.)", 6 },
        { "Repo notional (started)", 7 },
        { "Rev. repo notional (started)", 8 },
        { "Forward-starting (not counted)", 9 }
    }
)


P6 X1 Line 1 =
VAR _w = [P6 X Weeks]
VAR _t = [P6 X Tenor]
VAR _n = [P6 X Tenor Norm]
RETURN
    FORMAT ( COALESCE ( [P6 X Deals], 0 ), "#,0" ) & " new deals in the last "
        & IF ( _w = 1, "week", _w & " weeks" )
        & IF ( NOT ISBLANK ( _t ), " · average tenor " & IF ( _t < 0.25, FORMAT ( _t * 365, "0" ) & " days", IF ( _t < 1, FORMAT ( _t * 12, "0" ) & " months", FORMAT ( _t, "0.0" ) & " years" ) )
            & IF ( NOT ISBLANK ( _n ), " (12-wk avg " & IF ( _n < 0.25, FORMAT ( _n * 365, "0" ) & " days", IF ( _n < 1, FORMAT ( _n * 12, "0" ) & " months", FORMAT ( _n, "0.0" ) & " years" ) ) & ")" ) )




P6 X1 Notional Δ Text =
VAR _v = [P6 X Notional Δ]
RETURN IF ( ISBLANK ( _v ), "too few deals to compare", "notional " & FORMAT ( _v, "+0%;-0%;0%" ) & " vs 12-wk avg" )


P6 X1 Deals Δ Text =
VAR _v = [P6 X Deals Δ]
RETURN IF ( NOT ISBLANK ( _v ), "deals " & FORMAT ( _v, "+0%;-0%;0%" ) & " vs 12-wk avg" )

