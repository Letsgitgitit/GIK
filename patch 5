    "Compares a code to it", IF( CONTAINSSTRING( [Expression], "SGC_UnitCode] = " ), "yes", "no" ),
    "Patch 10 in", IF( CONTAINSSTRING( [Expression], "TREATAS( uSet" ), "set pattern", "" )
)
ORDER BY [Measure]

// ---- C1  Netting line, whole book, last 5 RECONC dates, new default ticks -------------------------
EVALUATE
SUMMARIZECOLUMNS(
    DIM_DATE[Date],
    TREATAS( _Last5, DIM_DATE[Date] ),
    TREATAS( _NewTicks, 'P1 Unit'[Unit Code] ),
    "Old (live) netting", [17AB Netting %],
    "New netting", [17AB Netting % NEW],
    "17A Util", [17A Util],
    "17B Util", [17B Util]
)
ORDER BY DIM_DATE[Date] DESC

// ---- C2  CPY-HF: old vs new default ticks ---------------------------------------------------------
EVALUATE
VAR f = TREATAS( { _Id }, DIM_COUNTERPARTY[HeadOfficeSirisId] )
RETURN
UNION(
    ROW( "Ticks", "old 10 / 2155 / 2164",
         "17A Util", CALCULATE( [17A Util], f, TREATAS( _OldTicks, 'P1 Unit'[Unit Code] ) ),
         "17B Util", CALCULATE( [17B Util], f, TREATAS( _OldTicks, 'P1 Unit'[Unit Code] ) ),
         "Netting NEW", CALCULATE( [17AB Netting % NEW], f, TREATAS( _OldTicks, 'P1 Unit'[Unit Code] ) ),
         "Unit Label", CALCULATE( [Unit Label], f, TREATAS( _OldTicks, 'P1 Unit'[Unit Code] ) ) ),
    ROW( "Ticks", "new 10 / 2140 / 2155 / 2164 / 2195",
         "17A Util", CALCULATE( [17A Util], f, TREATAS( _NewTicks, 'P1 Unit'[Unit Code] ) ),
         "17B Util", CALCULATE( [17B Util], f, TREATAS( _NewTicks, 'P1 Unit'[Unit Code] ) ),
         "Netting NEW", CALCULATE( [17AB Netting % NEW], f, TREATAS( _NewTicks, 'P1 Unit'[Unit Code] ) ),
         "Unit Label", CALCULATE( [Unit Label], f, TREATAS( _NewTicks, 'P1 Unit'[Unit Code] ) ) )
)





Rev RpR Annual =
-- Annualised revenue per €100k of average daily 16A utilisation, same window and selection.
-- Comparable across window lengths: revenue scaled to 365 days, divided by the average level of risk.
VAR s = [Rev Window Start]
VAR e = [Rev Window End]
VAR days = INT( e - s ) + 1
RETURN
    IF( days > 0,
        DIVIDE( [Rev Revenue EUR] * 365 / days, [16A Avg Util] ) * 100000 )
