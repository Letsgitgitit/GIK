// =====================================================================================
// P6W_SETUP_PATCH_07.dax  -  BUILD 2026-11-12b  -  tables for the "PX 16A move explainer" drill-through page
// Run BEFORE P6A_MEASURES_TE2.csx build 12e (the script stops if these tables are missing).
// HOW (each block): Modeling ▸ New table ▸ paste the block (name included) ▸ Enter. No relationships to any of them.
// =====================================================================================

// ---- S1 window buttons. Then: Window ▸ Column tools ▸ Sort by column ▸ Order. Hide Days and Order.
PX Window =
DATATABLE (
    "Window", STRING, "Days", INTEGER, "Order", INTEGER,
    { { "1D", 1, 1 }, { "1W", 7, 2 }, { "2W", 14, 3 }, { "1M", 30, 4 }, { "Custom", 0, 5 } }
)

// ---- S2 custom dates ("From" and "To" pickers, used only when Window = Custom). Weekdays since Jan 2025.
PX From =
SELECTCOLUMNS ( FILTER ( CALENDAR ( DATE ( 2025, 1, 1 ), TODAY () ), WEEKDAY ( [Date], 2 ) <= 5 ), "Date", [Date] )

PX To =
SELECTCOLUMNS ( FILTER ( CALENDAR ( DATE ( 2025, 1, 1 ), TODAY () ), WEEKDAY ( [Date], 2 ) <= 5 ), "Date", [Date] )
// For both: select the Date column ▸ Column tools ▸ Format ▸ d mmm yyyy.

// ---- S3 waterfall steps (the X axis of the waterfall). Then: Step ▸ Sort by column ▸ Order. Hide Order.
PX Step =
DATATABLE (
    "Step", STRING, "Order", INTEGER,
    {
        { "16A start", 1 },
        { "Matured trades", 2 },
        { "New trades", 3 },
        { "Revaluation", 4 },
        { "Netting", 5 },
        { "Non-repo", 6 },
        { "16A end", 7 }
    }
)

// ---- S4 (12 Nov b) Sponsored switch (FICC / DTCC repo). Default Exclude = the 6 Nov HF rule. Sort Sponsored by Order.
PX Sponsored =
DATATABLE ( "Sponsored", STRING, "Order", INTEGER, { { "Exclude", 1 }, { "Include", 2 } } )
