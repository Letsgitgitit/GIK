// =====================================================================================
// P1_PATCH_12_CHECK.dax  -  BUILD 2026-11-10a  -  read-only
// C0 before the patch (which measures still compare a centre code to [Unit Selected]).
// C1 / C2 run the NEW netting measure query-scoped, so they work before or after the patch.
// RUN: DAX query view > paste > Run. 3 result tabs. Ids only in the output.
// =====================================================================================
DEFINE
    VAR _Id = "0001228674"                                       // CPY-HF (generic label)
    VAR _OldTicks = { "10", "2155", "2164" }                     // patch 10 default
    VAR _NewTicks = { "10", "2140", "2155", "2164", "2195" }     // patch 12 default
    VAR _Last5 = TOPN( 5, VALUES( FACT_RECONC[SnapshotDate] ), FACT_RECONC[SnapshotDate], DESC )

    MEASURE '_Measures'[17AB Netting % NEW] =
        VAR d = [Snap RECONC]
        VAR uSet = VALUES( 'P1 Unit'[Unit Code] )
        VAR auths =
            CALCULATETABLE(
                SUMMARIZE( FACT_RECONC, FACT_RECONC[AuthorisationId], FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
                DIM_DATE[Date] = d,
                FACT_RECONC[Category] IN { "17A", "17B" },
                TREATAS( uSet, FACT_RECONC[SGC_UnitCode] ),
                FACT_RECONC[IsNoAuthorisation] = FALSE (),
                NOT ISBLANK( FACT_RECONC[AuthorisationId] ) )
        VAR perAuth =
            CALCULATETABLE(
                ADDCOLUMNS(
                    SUMMARIZE( FACT_RECONC, FACT_RECONC[HeadOfficeSirisId], FACT_RECONC[AuthorisationId],
                               FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
                    "@u", CALCULATE( MAX( FACT_RECONC[UtilEUR] ) ) ),
                REMOVEFILTERS( DIM_COUNTERPARTY ),
                TREATAS( auths, FACT_RECONC[AuthorisationId], FACT_RECONC[SGC_UnitCode], FACT_RECONC[Category] ),
                DIM_DATE[Date] = d,
                FACT_RECONC[IsEnvelopeTotal] = TRUE () )
        VAR perCpy =
            GROUPBY( perAuth, FACT_RECONC[HeadOfficeSirisId],
                "@a", SUMX( CURRENTGROUP (), IF( FACT_RECONC[Category] = "17A", [@u] ) ),
                "@b", SUMX( CURRENTGROUP (), IF( FACT_RECONC[Category] = "17B", [@u] ) ) )
        RETURN
            IF( NOT ISBLANK( d ),
                DIVIDE( SUMX( perCpy, 2 * MIN( [@a], [@b] ) ), SUMX( perCpy, [@a] + [@b] ) ) )

// ---- C0  Measures reading [Unit Selected] (Compares = yes -> breaks with several centres ticked) --
