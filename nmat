            }
        )
    VAR _hfDim =
        ADDCOLUMNS(
            SELECTCOLUMNS(
                FILTER( ALL( DIM_COUNTERPARTY ), LEN( DIM_COUNTERPARTY[Name] ) > 0 ),
                "Id", DIM_COUNTERPARTY[HeadOfficeSirisId],
                "DimName", DIM_COUNTERPARTY[Name],
                "CPH_Id", DIM_COUNTERPARTY[CPH_Id],
                "CPH_Name", DIM_COUNTERPARTY[CPH_Name],
                "InCORTEX", DIM_COUNTERPARTY[InCORTEX]
            ),
            "Key",
                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(
                    UPPER( TRIM( [DimName] ) ) & " ", " LIMITED ", " LTD " ),
                    ".", "" ), ",", "" ), "'", "" ), "-", "" ), " ", "" )
        )
    VAR _hfKeyed =
        ADDCOLUMNS(
            _hfNames,
            "RKey",
                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(
                    UPPER( TRIM( [ReportName] ) ) & " ", " LIMITED ", " LTD " ),
                    ".", "" ), ",", "" ), "'", "" ), "-", "" ), " ", "" )
        )
    VAR _hfCand =
        GENERATEALL(
            _hfKeyed,
            VAR k = [RKey]
            VAR p20 = LEFT( k, 20 )
            VAR p15 = LEFT( k, 15 )
            VAR exact = FILTER( _hfDim, [Key] = k )
            VAR nE = COUNTROWS( exact )
            VAR pref = FILTER( _hfDim, nE = 0 && LEFT( [Key], 20 ) = p20 )
            VAR nP = COUNTROWS( pref )
            VAR cont = FILTER( _hfDim, nE = 0 && nP = 0 && CONTAINSSTRING( [Key], p15 ) )
            VAR allC =
                UNION(
                    ADDCOLUMNS( exact, "Match", "1 exact" ),
                    ADDCOLUMNS( pref, "Match", "2 prefix20" ),
                    ADDCOLUMNS( cont, "Match", "3 contains15" )
                )
            RETURN
                ADDCOLUMNS(
                    TOPN( 5, allC, [InCORTEX], DESC, [Id], ASC ),
                    "Candidates", COUNTROWS( allC )
                )
        )

// ---- M1 candidates -----------------------------------------------------------------------
EVALUATE
    SELECTCOLUMNS(
        _hfCand,
        "ReportName", [ReportName],
        "Match", [Match],
        "Candidates", [Candidates],
        "HeadOfficeSirisId", [Id],
        "DimName", [DimName],
        "CPH_Id", [CPH_Id],
        "CPH_Name", [CPH_Name],
        "InCORTEX", [InCORTEX]
    )
    ORDER BY [ReportName], [Match], [InCORTEX] DESC

// ---- M2 summary per report name ------------------------------------------------------------
EVALUATE
    ADDCOLUMNS(
        _hfNames,
        "BestMatch",
            VAR n = [ReportName]
            RETURN MINX( FILTER( _hfCand, [ReportName] = n ), [Match] ),
        "Candidates",
            VAR n = [ReportName]
            RETURN MAXX( FILTER( _hfCand, [ReportName] = n ), [Candidates] )
    )
    ORDER BY [BestMatch] DESC, [ReportName]
