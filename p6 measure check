// P6A_MEASURES_CHECK_3.dax  -  BUILD 2026-11-06a  -  read-only. What moved HF 16A between 23 Oct and 26 Oct 2026?
// T (PFE trend) shows util €884m -> €408m and limit €8.60bn -> €7.10bn over that weekend. One row per CPH whose 16A util or
// limit changed by more than €5m, both dates on facts, A3b exclusion as at each date (the page logic, As-of picked).
DEFINE
    VAR _kScope = TREATAS ( { "Hedge fund" }, DIM_COUNTERPARTY[HF Scope] )
    VAR _kFacts = TREATAS ( { "Facts" }, 'P1 Source'[Source] )
    VAR _d1 = DATE ( 2026, 10, 23 )
    VAR _d2 = DATE ( 2026, 10, 26 )
EVALUATE
    VAR _t =
        SUMMARIZECOLUMNS ( DIM_COUNTERPARTY[CPH_Label], _kScope, _kFacts,
            "Util_23Oct", CALCULATE ( [P6 16A Util], TREATAS ( { _d1 }, 'P6W AsOf'[Date] ) ),
            "Util_26Oct", CALCULATE ( [P6 16A Util], TREATAS ( { _d2 }, 'P6W AsOf'[Date] ) ),
            "Limit_23Oct", CALCULATE ( [P6 16A Limit], TREATAS ( { _d1 }, 'P6W AsOf'[Date] ) ),
            "Limit_26Oct", CALCULATE ( [P6 16A Limit], TREATAS ( { _d2 }, 'P6W AsOf'[Date] ) ),
            "Excl_23Oct", CALCULATE ( [P6 Excluded Note], TREATAS ( { _d1 }, 'P6W AsOf'[Date] ) ),
            "Excl_26Oct", CALCULATE ( [P6 Excluded Note], TREATAS ( { _d2 }, 'P6W AsOf'[Date] ) ) )
    RETURN
        FILTER ( _t, ABS ( [Util_26Oct] - [Util_23Oct] ) > 5E6 || ABS ( [Limit_26Oct] - [Limit_23Oct] ) > 5E6 )
    ORDER BY [Util_23Oct] DESC
EVALUATE
    CALCULATETABLE (
        ROW ( "Excl_23Oct", CALCULATE ( [P6 Excluded Note], TREATAS ( { _d1 }, 'P6W AsOf'[Date] ) ),
              "Excl_26Oct", CALCULATE ( [P6 Excluded Note], TREATAS ( { _d2 }, 'P6W AsOf'[Date] ) ),
              "Excl_4Nov", [P6 Excluded Note] ),
        _kScope, _kFacts )
