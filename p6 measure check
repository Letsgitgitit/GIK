// P6A_MEASURES_CHECK_2.dax  -  BUILD 2026-11-06a  -  read-only. Why the NAV scatter's 75th percentile came out 0 on CORTEX.
// D1: per CPH at the NAV month-end (31 Aug), 16A on facts vs CORTEX, and the CORTEX file date used.
// Expect: if CORTEX util is 0 / blank for most CPHs on 31 Aug while facts are not, CORTEX history is thin before Oct and
// the scatter (and K5) should read facts at the NAV date.
DEFINE
    VAR _kScope = TREATAS ( { "Hedge fund" }, DIM_COUNTERPARTY[HF Scope] )
EVALUATE
    VAR _n = [P6 NAV Month]
    RETURN
        FILTER (
            SUMMARIZECOLUMNS ( DIM_COUNTERPARTY[CPH_Label], _kScope,
                "NAV_USD", [P6 NAV Cur USD],
                "Util_Facts", CALCULATE ( [P6 N Util], TREATAS ( { "Facts" }, 'P1 Source'[Source] ) ),
                "Util_CORTEX", CALCULATE ( [P6 N Util], TREATAS ( { "CORTEX" }, 'P1 Source'[Source] ) ),
                "CxLimit_atNAV", CALCULATE ( [Cx 16A Limit], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _n - 31, _n ) ),
                "CxUtil_atNAV", CALCULATE ( [Cx 16A Util], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _n - 31, _n ) ),
                "CxDate_atNAV", CALCULATE ( [Cx Date], REMOVEFILTERS ( DIM_DATE ), DATESBETWEEN ( DIM_DATE[Date], _n - 31, _n ) ) ),
            NOT ISBLANK ( [NAV_USD] ) )
EVALUATE
    CALCULATETABLE (
        ROW ( "P75_Facts", CALCULATE ( [P6 N Util Over NAV P75], TREATAS ( { "Facts" }, 'P1 Source'[Source] ) ),
              "P75_CORTEX", CALCULATE ( [P6 N Util Over NAV P75], TREATAS ( { "CORTEX" }, 'P1 Source'[Source] ) ),
              "CORTEX_first_file", CALCULATE ( MIN ( FACT_CORTEX[SnapshotDate] ), REMOVEFILTERS () ) ),
        _kScope )
